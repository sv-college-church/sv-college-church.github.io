---
import { getActiveBannerEvent } from '../lib/events';

const event = await getActiveBannerEvent();
const banner = event?.data.banner;
// Keyed to this specific event (its content-collection slug) so dismissing
// one banner event doesn't suppress a future, different one.
const bannerId = event?.slug ?? '';
---

{banner && (
  <div class="announcement-banner" id="event-banner" data-event-banner data-banner-id={bannerId}>
    {banner.cta && (
      // Invisible "stretched link" covering the whole banner so it's clickable
      // anywhere, not just the visible CTA button. aria-hidden + tabindex="-1"
      // keep it out of the accessibility tree and tab order — the visible CTA
      // link below is the one screen reader / keyboard users interact with.
      <a href={banner.cta.url} class="banner-hit-area" aria-hidden="true" tabindex="-1"></a>
    )}
    <span class="banner-text">
      <span class="label-full">{banner.emoji ? `${banner.emoji} ` : ''}{banner.text}</span>
      <span class="label-short">{banner.emoji ? `${banner.emoji} ` : ''}{banner.shortText}</span>
    </span>
    {banner.cta && (
      <a href={banner.cta.url} class="event-banner-link">
        <span class="label-full">{banner.cta.label} →</span>
        <span class="label-short">{banner.cta.shortLabel} →</span>
      </a>
    )}
    <button type="button" class="banner-dismiss" aria-label="Dismiss announcement" data-banner-dismiss>
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <script is:inline define:vars={{ bannerId }}>
    // Runs immediately (not deferred) so a dismissal from earlier this
    // session hides the banner before it has a chance to flash on screen.
    // Dismissal is per-tab-session (sessionStorage), not permanent — a new
    // visit (new browser session) shows the banner again, by design.
    (function () {
      try {
        if (sessionStorage.getItem('dismissed-banner-' + bannerId) === '1') {
          var el = document.currentScript && document.currentScript.previousElementSibling;
          if (el) el.style.display = 'none';
        }
      } catch (e) {}
    })();
  </script>
)}

<script>
  // The banner is fixed above the nav. We measure its height and offset
  // both the body (so page content clears it) and the fixed nav header.
  function applyBannerOffset() {
    const banner = document.querySelector<HTMLElement>('[data-event-banner]');
    const nav = document.querySelector<HTMLElement>('.nav-header');
    const visible = banner && banner.style.display !== 'none';
    const h = visible ? banner!.offsetHeight : 0;
    document.body.style.paddingTop = h ? `${h}px` : '';
    document.documentElement.style.setProperty('--banner-height', `${h}px`);
    if (nav) nav.style.top = h ? `${h}px` : '';
  }

  // Dismissing hides the banner for the rest of this tab session
  // (sessionStorage — cleared when the tab/browser session ends, so the
  // banner is back on the next visit) and immediately collapses the
  // offset it was holding open for the nav/page content.
  function initBannerDismiss() {
    const banner = document.querySelector<HTMLElement>('[data-event-banner]');
    const btn = document.querySelector<HTMLElement>('[data-banner-dismiss]');
    if (!banner || !btn) return;
    const id = banner.dataset.bannerId ?? '';
    btn.addEventListener('click', () => {
      try {
        sessionStorage.setItem('dismissed-banner-' + id, '1');
      } catch {
        // sessionStorage unavailable (private mode, etc.) — dismiss still
        // works for this page view, just won't stick across navigations.
      }
      banner.style.display = 'none';
      applyBannerOffset();
    });
  }

  document.addEventListener('astro:page-load', () => {
    applyBannerOffset();
    initBannerDismiss();
  });
  // ViewTransitions: reset before swap so the new page doesn't inherit stale offsets
  document.addEventListener('astro:before-swap', () => {
    document.body.style.paddingTop = '';
    document.documentElement.style.setProperty('--banner-height', '0px');
    const nav = document.querySelector<HTMLElement>('.nav-header');
    if (nav) nav.style.top = '';
  });
  window.addEventListener('resize', applyBannerOffset);
</script>

<style>
  /* Visual parity with the original Easter banner (commit 0b9bf93 / removed in ded431f). */
  .announcement-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: #0A0A0A;
    padding: clamp(0.6rem, 1.4vh, 1.1rem) 3.5rem;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60; /* above .nav-header (z-50) */
    transition: transform 0.3s ease;
    animation: bannerFadeIn 0.35s ease-out;
  }

  @keyframes bannerFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Sticky with the nav — Nav.astro's scroll listener toggles this same
     class on both the header and the banner together, so they hide/show
     on scroll as one unit. Own-height translate is correct here since,
     unlike the header, the banner always rests at top: 0. */
  .announcement-banner.nav-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-banner { transition: none; animation: none; }
  }

  .banner-text {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #F5F5F0;
    line-height: 1;
  }

  .event-banner-link {
    position: relative;
    z-index: 1; /* stay above .banner-hit-area for hover/click */
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    line-height: 1;
    color: #F5F5F0;
    background: #D91C2A;
    padding: 0.65rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .event-banner-link:hover { background: #b51623; }

  /* Covers the entire banner so clicking anywhere (not just the CTA button)
     navigates to it. Sits beneath the CTA link and dismiss button so both
     stay independently interactive. */
  .banner-hit-area {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: pointer;
  }

  /* Independent of the centered text+CTA group so closing it doesn't
     shift their centering. */
  .banner-dismiss {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2; /* above .banner-hit-area */
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    line-height: 1;
    color: rgba(245, 245, 240, 0.7);
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .banner-dismiss:hover {
    color: #F5F5F0;
    background: rgba(245, 245, 240, 0.12);
  }
  .banner-dismiss:focus-visible {
    outline: 2px solid #F5F5F0;
    outline-offset: 1px;
  }

  .label-short { display: none; }

  @media (max-width: 640px) {
    .announcement-banner {
      gap: 0.6rem;
      padding: 0.7rem 2.5rem;
    }
    .banner-text .label-full { display: none; }
    .banner-text .label-short { display: inline; }
    .event-banner-link .label-full { display: none; }
    .event-banner-link .label-short { display: inline; }
    .banner-text {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
    }
    .event-banner-link {
      font-size: 0.68rem;
      padding: 0.45rem 0.85rem;
      letter-spacing: 0.14em;
      flex-shrink: 0;
    }
    .banner-dismiss {
      right: 0.5rem;
      width: 24px;
      height: 24px;
      font-size: 1.2rem;
    }
  }
</style>
