---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import EventBanner from '../components/EventBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /**
   * Extra JSON-LD blocks for this page (breadcrumbs, events, FAQs, campus orgs).
   * Rendered after the sitewide Church schema, one <script> per entry.
   */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/images/og-image.png',
  canonicalUrl = Astro.url.href,
  noindex = false,
  structuredData,
} = Astro.props;

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="Silicon Valley College Church" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Mobile browser chrome -->
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="apple-touch-icon" href="/images/svc-logo-black.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Church",
      "name": "Silicon Valley College Church",
      "alternateName": "SVC",
      "description": "A church for college students in the South Bay and Silicon Valley, with campus ministries at Stanford University, San José State University, Santa Clara University, UC Santa Cruz, and De Anza College.",
      "url": Astro.site?.href,
      "logo": new URL('/images/svc-logo-black.png', Astro.site).href,
      "sameAs": [
        "https://www.instagram.com/sv.collegechurch",
        "https://open.spotify.com/show/22GK3NSUnfEpNWD7GC9GmM"
      ],
      "areaServed": [
        "San Jose, CA",
        "Santa Clara, CA",
        "Palo Alto, CA",
        "Cupertino, CA",
        "Santa Cruz, CA"
      ],
      "knowsAbout": [
        "College ministry",
        "Campus ministry",
        "Christian student clubs",
        "Bible study"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "55 N 7th St",
        "addressLocality": "San Jose",
        "addressRegion": "CA",
        "postalCode": "95112",
        "addressCountry": "US"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Sunday",
        "opens": "12:00",
        "closes": "13:30"
      }
    })} />

    {extraSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <EventBanner />
    <slot />

    <!-- Scroll-to-navigate reveal — mobile only, see script below -->
    <div id="scroll-nav-reveal" aria-hidden="true">
      <span class="reveal-label"></span>
    </div>

    <!-- Scroll animation observer — re-runs on View Transitions navigation -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('not-yet-visible');
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('[data-animate]').forEach((el) => {
          el.classList.remove('is-visible', 'not-yet-visible');
          const rect = el.getBoundingClientRect();
          const alreadyInView = rect.top < window.innerHeight && rect.bottom > 0;
          if (!alreadyInView) {
            el.classList.add('not-yet-visible');
          }
          observer.observe(el);
        });
      });
    </script>

    <!-- Scroll-to-navigate (mobile only) — pulling up past the bottom of
         the page advances to the next page in the site's nav sequence;
         pulling down past the top goes to the previous page (mirrored
         gesture). Listeners are attached once here, not inside
         astro:page-load, since `window` persists across View Transitions
         navigations — re-attaching per navigation would stack duplicate
         listeners. Current/next/prev page are read fresh from
         location.pathname on every touch, so this stays correct without
         re-initializing. Sequence order lives in src/lib/pageSequence.ts —
         reorder pages there, not here. -->
    <script>
      import { navigate } from 'astro:transitions/client';
      import { getNextPage, getPrevPage } from '../lib/pageSequence';

      const TRIGGER_PX = 80;
      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

      function isAtBottom(): boolean {
        return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      }

      function isAtTop(): boolean {
        return window.scrollY <= 2;
      }

      function getReveal(): HTMLElement | null {
        return document.getElementById('scroll-nav-reveal');
      }

      function getRevealLabel(): HTMLElement | null {
        return document.querySelector('#scroll-nav-reveal .reveal-label');
      }

      type Direction = 'forward' | 'backward';

      // Distance from the touch point to the farthest viewport corner —
      // the radius the reveal circle needs to fully cover the screen.
      function maxRadius(x: number, y: number): number {
        const dx = Math.max(x, window.innerWidth - x);
        const dy = Math.max(y, window.innerHeight - y);
        return Math.hypot(dx, dy);
      }

      let originX = 0;
      let originY = 0;
      let lastProgress = 0;

      function updateReveal(progress: number, label: string, direction: Direction) {
        const root = getReveal();
        const labelEl = getRevealLabel();
        if (!root) return;
        lastProgress = progress;
        root.classList.remove('is-releasing');
        const radius = maxRadius(originX, originY) * progress;
        root.style.clipPath = `circle(${radius}px at ${originX}px ${originY}px)`;
        if (labelEl) labelEl.textContent = `${direction === 'forward' ? '↓' : '↑'} ${label}`;
      }

      function resetReveal() {
        const root = getReveal();
        if (!root) return;
        lastProgress = 0;
        root.classList.add('is-releasing');
        root.style.clipPath = `circle(0px at ${originX}px ${originY}px)`;
      }

      let startY = 0;
      // 'pending' = touch started at an edge on a sequence page, but we
      // haven't seen which way the user is dragging yet (matters on short
      // pages where top and bottom edges coincide).
      let mode: Direction | 'pending' | null = null;

      window.addEventListener('touchstart', (e) => {
        mode = null;
        if (!isMobile()) return;
        if (!isAtBottom() && !isAtTop()) return;
        originX = e.touches[0].clientX;
        originY = e.touches[0].clientY;
        startY = originY;
        mode = 'pending';
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!mode) return;
        const currentY = e.touches[0].clientY;
        const rawDelta = startY - currentY; // positive = finger moved up

        if (mode === 'pending') {
          if (rawDelta > 0 && isAtBottom() && getNextPage(location.pathname)) {
            mode = 'forward';
          } else if (rawDelta < 0 && isAtTop() && getPrevPage(location.pathname)) {
            mode = 'backward';
          } else {
            return;
          }
        }

        if (mode === 'forward') {
          const next = getNextPage(location.pathname);
          if (!next || !isAtBottom()) { mode = null; resetReveal(); return; }
          if (rawDelta <= 0) { resetReveal(); return; }
          updateReveal(Math.min(rawDelta / TRIGGER_PX, 1), next.label, 'forward');
        } else {
          const prev = getPrevPage(location.pathname);
          if (!prev || !isAtTop()) { mode = null; resetReveal(); return; }
          const pull = -rawDelta;
          if (pull <= 0) { resetReveal(); return; }
          updateReveal(Math.min(pull / TRIGGER_PX, 1), prev.label, 'backward');
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        if (!mode || mode === 'pending') { mode = null; return; }
        const target = mode === 'forward' ? getNextPage(location.pathname) : getPrevPage(location.pathname);
        const progress = lastProgress;
        mode = null;
        if (target && progress >= 1) {
          // Leave the circle fully expanded rather than resetting it —
          // the fresh page's reveal element starts clipped to nothing
          // again on its own, so this reads as the circle "consuming"
          // the old page rather than snapping back before the swap.
          navigate(target.href);
        } else {
          resetReveal();
        }
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: #0A0A0A;
    color: #F5F5F0;
    padding: 0.75rem 1.25rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 0;
  }

  /* ── Scroll-to-navigate reveal ──
     A charcoal circle grows outward from the touch point as the user
     drags past the top/bottom of the page on mobile (see script). The
     destination label lives inside the same clip-path, so it only
     becomes visible once the circle physically grows large enough to
     reach it — no separate fade needed. At progress 1 the circle covers
     the full viewport and the page swap fires; releasing early animates
     the circle back down to nothing via .is-releasing. */
  #scroll-nav-reveal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    background: #23201D;
    clip-path: circle(0px at 50% 50%);
  }

  #scroll-nav-reveal.is-releasing {
    transition: clip-path 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #scroll-nav-reveal .reveal-label {
    color: #F6F1E4;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }
</style>
