---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import EventBanner from '../components/EventBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /**
   * Extra JSON-LD blocks for this page (breadcrumbs, events, FAQs, campus orgs).
   * Rendered after the sitewide Church schema, one <script> per entry.
   */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/images/og-image.png',
  canonicalUrl = Astro.url.href,
  noindex = false,
  structuredData,
} = Astro.props;

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="Silicon Valley College Church" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Mobile browser chrome -->
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="apple-touch-icon" href="/images/svc-logo-black.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Church",
      "name": "Silicon Valley College Church",
      "alternateName": "SVC",
      "description": "A church for college students in the South Bay and Silicon Valley, with campus ministries at Stanford University, San José State University, Santa Clara University, UC Santa Cruz, and De Anza College.",
      "url": Astro.site?.href,
      "logo": new URL('/images/svc-logo-black.png', Astro.site).href,
      "sameAs": [
        "https://www.instagram.com/sv.collegechurch",
        "https://open.spotify.com/show/22GK3NSUnfEpNWD7GC9GmM"
      ],
      "areaServed": [
        "San Jose, CA",
        "Santa Clara, CA",
        "Palo Alto, CA",
        "Cupertino, CA",
        "Santa Cruz, CA"
      ],
      "knowsAbout": [
        "College ministry",
        "Campus ministry",
        "Christian student clubs",
        "Bible study"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "55 N 7th St",
        "addressLocality": "San Jose",
        "addressRegion": "CA",
        "postalCode": "95112",
        "addressCountry": "US"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Sunday",
        "opens": "12:00",
        "closes": "13:30"
      }
    })} />

    {extraSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <EventBanner />
    <slot />

    <!-- Scroll-to-navigate hint — mobile only, see script below -->
    <div id="scroll-nav-hint" aria-hidden="true"></div>

    <!-- Scroll animation observer — re-runs on View Transitions navigation -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('not-yet-visible');
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('[data-animate]').forEach((el) => {
          el.classList.remove('is-visible', 'not-yet-visible');
          const rect = el.getBoundingClientRect();
          const alreadyInView = rect.top < window.innerHeight && rect.bottom > 0;
          if (!alreadyInView) {
            el.classList.add('not-yet-visible');
          }
          observer.observe(el);
        });
      });
    </script>

    <!-- Scroll-to-navigate (mobile only) — pulling up past the bottom of
         the page advances to the next page in the site's nav sequence;
         pulling down past the top goes to the previous page (mirrored
         gesture). Listeners are attached once here, not inside
         astro:page-load, since `window` persists across View Transitions
         navigations — re-attaching per navigation would stack duplicate
         listeners. Current/next/prev page are read fresh from
         location.pathname on every touch, so this stays correct without
         re-initializing. Sequence order lives in src/lib/pageSequence.ts —
         reorder pages there, not here. -->
    <script>
      import { getNextPage, getPrevPage } from '../lib/pageSequence';

      const TRIGGER_PX = 80;
      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

      function isAtBottom(): boolean {
        return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      }

      function isAtTop(): boolean {
        return window.scrollY <= 2;
      }

      function getHint(): HTMLElement | null {
        return document.getElementById('scroll-nav-hint');
      }

      type Direction = 'forward' | 'backward';

      // Forward pill lives at the bottom (hidden 20px below its resting
      // spot); backward pill lives at the top (hidden 20px above it).
      function restOffset(direction: Direction | null): number {
        return direction === 'backward' ? -20 : 20;
      }

      let activeDirection: Direction | null = null;

      function updateHint(progress: number, label: string, direction: Direction) {
        const hint = getHint();
        if (!hint) return;
        activeDirection = direction;
        hint.classList.remove('is-releasing');
        hint.classList.toggle('hint-top', direction === 'backward');
        hint.textContent = `${direction === 'forward' ? '↓' : '↑'} ${label}`;
        hint.style.opacity = String(progress);
        const offset = restOffset(direction) * (1 - progress);
        hint.style.transform = `translateX(-50%) translateY(${offset}px) scale(${0.85 + progress * 0.15})`;
      }

      function resetHint() {
        const hint = getHint();
        if (!hint) return;
        hint.classList.add('is-releasing');
        hint.style.opacity = '0';
        hint.style.transform = `translateX(-50%) translateY(${restOffset(activeDirection)}px) scale(0.85)`;
      }

      let startY = 0;
      // 'pending' = touch started at an edge on a sequence page, but we
      // haven't seen which way the user is dragging yet (matters on short
      // pages where top and bottom edges coincide).
      let mode: Direction | 'pending' | null = null;

      window.addEventListener('touchstart', (e) => {
        mode = null;
        if (!isMobile()) return;
        if (!isAtBottom() && !isAtTop()) return;
        startY = e.touches[0].clientY;
        mode = 'pending';
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!mode) return;
        const currentY = e.touches[0].clientY;
        const rawDelta = startY - currentY; // positive = finger moved up

        if (mode === 'pending') {
          if (rawDelta > 0 && isAtBottom() && getNextPage(location.pathname)) {
            mode = 'forward';
          } else if (rawDelta < 0 && isAtTop() && getPrevPage(location.pathname)) {
            mode = 'backward';
          } else {
            return;
          }
        }

        if (mode === 'forward') {
          const next = getNextPage(location.pathname);
          if (!next || !isAtBottom()) { mode = null; resetHint(); return; }
          if (rawDelta <= 0) { resetHint(); return; }
          updateHint(Math.min(rawDelta / TRIGGER_PX, 1), next.label, 'forward');
        } else {
          const prev = getPrevPage(location.pathname);
          if (!prev || !isAtTop()) { mode = null; resetHint(); return; }
          const pull = -rawDelta;
          if (pull <= 0) { resetHint(); return; }
          updateHint(Math.min(pull / TRIGGER_PX, 1), prev.label, 'backward');
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        if (!mode || mode === 'pending') { mode = null; return; }
        const target = mode === 'forward' ? getNextPage(location.pathname) : getPrevPage(location.pathname);
        const hint = getHint();
        const progress = hint ? parseFloat(hint.style.opacity || '0') : 0;
        mode = null;
        resetHint();
        if (target && progress >= 1) {
          window.location.href = target.href;
        }
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: #0A0A0A;
    color: #F5F5F0;
    padding: 0.75rem 1.25rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 0;
  }

  /* ── Scroll-to-navigate hint ──
     Fades/scales in as the user pulls past the bottom (forward) or top
     (backward) of the page on mobile (see script). Full opacity == the
     pull has crossed the trigger threshold; releasing at that point
     navigates to the next/previous page in sequence. Sits at the bottom
     by default (forward gesture); the script adds .hint-top to move it
     up near the backward gesture's starting point. */
  #scroll-nav-hint {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    top: auto;
    z-index: 60;
    transform: translateX(-50%) translateY(20px) scale(0.85);
    opacity: 0;
    pointer-events: none;
    background: #23201D;
    color: #F6F1E4;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  #scroll-nav-hint.is-releasing {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #scroll-nav-hint.hint-top {
    top: 1.25rem;
    bottom: auto;
  }
</style>
