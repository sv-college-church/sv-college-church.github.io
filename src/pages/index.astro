---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';

// Community photos — all 23 imported, Astro optimises at build time.
// JS picks a random 4 per page load via the existing shuffle logic.
import svc01 from '../assets/images/community/svc-01.webp';
import svc02 from '../assets/images/community/svc-02.webp';
import svc03 from '../assets/images/community/svc-03.webp';
import svc04 from '../assets/images/community/svc-04.webp';
import svc05 from '../assets/images/community/svc-05.webp';
import svc06 from '../assets/images/community/svc-06.webp';
import svc07 from '../assets/images/community/svc-07.webp';
import svc08 from '../assets/images/community/svc-08.webp';
import svc09 from '../assets/images/community/svc-09.webp';
import svc10 from '../assets/images/community/svc-10.webp';
import svc11 from '../assets/images/community/svc-11.webp';
import svc12 from '../assets/images/community/svc-12.webp';
import svc13 from '../assets/images/community/svc-13.webp';
import svc14 from '../assets/images/community/svc-14.webp';
import svc15 from '../assets/images/community/svc-15.webp';
import svc16 from '../assets/images/community/svc-16.webp';
import svc17 from '../assets/images/community/svc-17.webp';
import svc18 from '../assets/images/community/svc-18.webp';
import svc19 from '../assets/images/community/svc-19.webp';
import svc20 from '../assets/images/community/svc-20.webp';
import svc21 from '../assets/images/community/svc-21.webp';
import svc22 from '../assets/images/community/svc-22.webp';
import svc23 from '../assets/images/community/svc-23.webp';

const allSources = [
  svc01, svc02, svc03, svc04, svc05, svc06, svc07, svc08,
  svc09, svc10, svc11, svc12, svc13, svc14, svc15, svc16,
  svc17, svc18, svc19, svc20, svc21, svc22, svc23,
];

const optimized = await Promise.all(
  allSources.map(src => getImage({ src, width: 800, format: 'webp' }))
);
const photoUrls = optimized.map(img => img.src);
---

<BaseLayout title="Silicon Valley College Church | A Church for College Students in the South Bay" description="Silicon Valley College Church is a church for college students in the South Bay and Silicon Valley — Stanford University, San José State University, Santa Clara University, UC Santa Cruz, and De Anza College. Sundays in San Jose.">
  <Nav />

  <main id="main-content" class="pt-20 md:pt-32 main-content">

    <section id="hero" class="bg-paper">

      <!-- Text: fades in above photos after shrink -->
      <div id="text-wrapper">
        <h1 id="hero-text" class="uppercase leading-none">
          <span class="hero-line1">Silicon Valley</span>
          <span class="hero-line2">College Church</span>
        </h1>
      </div>

      <!-- Stack container: stays centered -->
      <div id="polaroid-stack" data-photos={JSON.stringify(photoUrls)}>
        <!-- Scale container: handles shrink -->
        <div id="polaroid-scale">
          <!-- Breathe container: handles idle ebb & flow -->
          <div id="polaroid-breathe">
            <div class="polaroid-card"><div class="card-inner"><img src={photoUrls[0]} alt="Students at Silicon Valley College Church" draggable="false" width="800" height="800" /></div></div>
            <div class="polaroid-card"><div class="card-inner"><img src={photoUrls[1]} alt="Students at Silicon Valley College Church" draggable="false" width="800" height="800" /></div></div>
            <div class="polaroid-card"><div class="card-inner"><img src={photoUrls[2]} alt="Students at Silicon Valley College Church" draggable="false" width="800" height="800" /></div></div>
            <div class="polaroid-card"><div class="card-inner"><img src={photoUrls[3]} alt="Students at Silicon Valley College Church" draggable="false" width="800" height="800" /></div></div>
          </div>
        </div>

        <!-- Corner stickers — true siblings of the scale wrapper (not nested
             inside it) so they can't get caught behind #polaroid-stack's
             ::after hover-zone or any stacking-context surprises from the
             breathe/fan transforms. JS mirrors the same scale value onto
             #photo-stickers directly, so they still shrink with the photo. -->
        <div id="photo-stickers">
          <a href="/class-of-2030" id="class-badge" class="photo-sticker sticker-2030" aria-label="Class of 2030 — welcome">
            <div class="badge-ring" aria-hidden="true">
              <span style="--a:0">✦</span>
              <span style="--a:24">W</span>
              <span style="--a:36">E</span>
              <span style="--a:48">L</span>
              <span style="--a:60">C</span>
              <span style="--a:72">O</span>
              <span style="--a:84">M</span>
              <span style="--a:96">E</span>
              <span style="--a:120">✦</span>
              <span style="--a:144">W</span>
              <span style="--a:156">E</span>
              <span style="--a:168">L</span>
              <span style="--a:180">C</span>
              <span style="--a:192">O</span>
              <span style="--a:204">M</span>
              <span style="--a:216">E</span>
              <span style="--a:240">✦</span>
              <span style="--a:264">W</span>
              <span style="--a:276">E</span>
              <span style="--a:288">L</span>
              <span style="--a:300">C</span>
              <span style="--a:312">O</span>
              <span style="--a:324">M</span>
              <span style="--a:336">E</span>
            </div>
            <div class="badge-center-content">
              <span class="badge-classof">Class of</span>
              <span class="badge-year-num">2030</span>
            </div>
          </a>

          <div id="sticker-sundays" class="photo-sticker sticker-sundays" aria-hidden="true">
            <span class="sticker-line1">Sundays</span>
            <span class="sticker-line2">12PM</span>
          </div>

          <div id="sticker-est" class="photo-sticker sticker-est" aria-hidden="true">
            <span class="sticker-line1">Est.</span>
            <span class="sticker-line2">2021</span>
          </div>
        </div>
      </div>

    </section>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* Nav hidden on load, fades in at 2.8s */
  header {
    animation: navFadeIn 0.4s ease 2.8s both;
  }
  footer {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  footer.is-visible {
    opacity: 1;
  }
  @keyframes navFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Warm cream carried into the shared Nav/Footer components, homepage-only.
     Nav's actual bg lives on a ::before pseudo-element (see Nav.astro), and
     Footer's is the Tailwind `bg-paper` utility — both overridden here with
     an extra type-selector qualifier so specificity beats the shared
     component styles without touching Nav.astro/Footer.astro directly. */
  header.nav-header::before {
    background: rgb(246 241 228 / 0.95) !important;
  }
  footer.bg-paper {
    background-color: #F6F1E4 !important;
  }
  nav.bg-paper {
    background-color: #F6F1E4 !important;
  }

  /* Homepage: fit everything in the viewport, no scrolling needed */
  body {
    height: 100svh;
    display: flex;
    flex-direction: column;
  }
</style>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* Match Nav's short-viewport height reduction */
  @media (min-width: 768px) and (max-height: 760px) {
    .main-content {
      padding-top: 5rem; /* matches Nav's 5rem height on short viewports */
    }
  }

  #hero {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    /* Warm cream, up from the site-wide cool paper tone — homepage-only for now */
    background-color: #F6F1E4;
    background-image: radial-gradient(circle, rgba(35, 32, 29, 0.015) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  /* Prevent horizontal scrollbar from fan animation.
     Use `clip` (not `hidden`) so <html> does NOT become a scroll container,
     which would otherwise require two scroll attempts to reach the top/bottom. */
  :global(html) {
    overflow-x: clip;
  }

  /* ── Stack: centered, no slide ── */
  #polaroid-stack {
    --card-w: clamp(240px, 46vw, 580px);
    --card-h: calc(var(--card-w) + 42px);

    position: absolute;
    width: var(--card-w);
    height: var(--card-h);
    left: 50%;
    top: 50%;
    margin-left: calc(var(--card-w) / -2);
    margin-top: calc(var(--card-h) / -2);
    transition: top 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    cursor: default;
  }

  /* Position set dynamically by JS based on available space */

  /* Invisible hover zone — extends hit area for horizontal fan (mouse
     devices only), sized to cover the cards once fully fanned out
     (translateX up to ±900px, see FAN_X) plus half a card width of
     margin so hovering a fanned card near its own edge doesn't
     accidentally leave the zone.
     Was a flat -1100px regardless of scale, but #polaroid-stack itself
     is never scaled — only its #polaroid-scale/#photo-stickers children
     are (dynScale often lands as low as 0.16-0.55 to fit short
     viewports) — so the hit-zone stayed at full, unscaled size while the
     actual photos shrank well inside it. That left a "dead" margin where
     hovering registered as still-on-the-stack despite being visibly far
     from any photo, which is what read as fanning staying stuck/
     unpredictable. --dyn-scale (set in JS alongside the real scale)
     keeps this in lockstep with the photo's true on-screen size. */
  @media (hover: hover) and (pointer: fine) {
    #polaroid-stack.settled::after {
      content: '';
      position: absolute;
      inset: 0 calc(-1100px * var(--dyn-scale, 1));
    }
  }

  /* ── Scale wrapper: shrink animation ── */
  #polaroid-scale {
    width: 100%;
    height: 100%;
    transform-origin: center center;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* ── Sticker layer: sibling of the scale wrapper, not nested inside it —
     see the comment in the markup above for why. JS mirrors the same scale
     value here directly so the stickers still shrink with the photo. ── */
  #photo-stickers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: center center;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    z-index: 30;
    pointer-events: none;
  }

  #photo-stickers .photo-sticker {
    pointer-events: auto;
  }

  /* The stickers are positioned for the settled, stacked photo — once the
     cards fan out horizontally (hover on desktop, swipe on mobile) they'd
     otherwise just sit frozen in place, landing awkwardly on top of
     whichever card fans out underneath them. `.fanned` is the one class
     every fan-trigger path (hover/touch/drag) already toggles on
     #polaroid-breathe, so react to it here with :has() instead of wiring
     up sticker visibility at each call site.
     Class of 2030 is excluded — it's a real link to another page, not
     just decoration, so it should never disappear on hover/touch.
     !important is needed here because .is-live/.is-breathing apply their
     opacity via CSS animations (forwards fill-mode), which normally
     outrank plain author rules in the cascade — only an !important
     author rule beats an active animation. */
  #polaroid-stack:has(#polaroid-breathe.fanned) #photo-stickers .photo-sticker:not(.sticker-2030) {
    opacity: 0 !important;
    pointer-events: none;
  }

  /* ── Breathe wrapper: idle ebb & flow ── */
  #polaroid-breathe {
    width: 100%;
    height: 100%;
  }

  #polaroid-breathe.breathing {
    animation: breathe 3.5s ease-in-out infinite;
  }

  #polaroid-breathe.fanned {
    animation-play-state: paused;
  }

  @keyframes breathe {
    0%, 100% { transform: translateY(0px)   scale(1);     }
    50%       { transform: translateY(-6px)  scale(1.018); }
  }

  /* ── Individual Polaroid cards ── */
  .polaroid-card {
    position: absolute;
    inset: 0;
    background: #ffffff;
    border-radius: 10px;
    padding: 14px 14px 56px;
    box-sizing: border-box;
    box-shadow:
      0 2px 6px  rgba(0, 0, 0, 0.07),
      0 8px 24px rgba(0, 0, 0, 0.11),
      0 24px 52px rgba(0, 0, 0, 0.07);
    opacity: 0;
    /* transform set by JS */
  }

  .card-inner {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
  }

  .card-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  /* ── Text wrapper: above the photos ── */
  #text-wrapper {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 3%;
    pointer-events: none;
    text-align: center;
    width: max-content;
    max-width: 90vw;
  }

  #text-wrapper.visible {
    pointer-events: auto;
  }

  #hero-text {
    color: #23201D;
    margin: 0;
    width: 100%;
    text-align: center;
  }

  /* ── Headline: one dominant line + a smaller, tilted second line —
     matches the "Campus Bulletin" mockup's proportions directly rather
     than two equal-sized lines with a "Welcome to" eyebrow above them. ── */
  .hero-line1 {
    display: block;
    /* Archivo, not Unbounded — the mockup's actual pixels were rendered in
       an Arial/Helvetica Neue fallback (Artifact's CSP blocks external
       font loading), and Archivo is the closest real webfont match to
       that sharper, flatter-cornered grotesque look. Unbounded is
       rounder/chunkier and reads differently at this size. Using the
       regular Archivo family (not Archivo Black, which only ships one
       maxed-out weight) so it can sit at 700 instead of reading as shouty. */
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    /* Sized down from an earlier pass (was clamp(2.4rem, min(7.2vw,10.5vh),
       7.2rem)) — at its old max this line ran ~1000px wide, well past the
       580px photo stack cap, which read much louder than the mockup where
       the headline sits closer to the photo's own width. */
    font-size: clamp(2.1rem, min(4.6vw, 7vh), 4.6rem);
    line-height: 1.05;
    color: #23201D;
    opacity: 0;
    transform: translateY(0.2em);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .hero-line2 {
    display: block;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.2rem, min(2.8vw, 4.2vh), 2.8rem);
    line-height: 1.05;
    color: #E2402F;
    margin-top: 0.25em;
    transform: rotate(-2deg) translateY(0.15em);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .hero-line1.visible,
  .hero-line2.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-line2.visible {
    transform: rotate(-2deg) translateY(0);
  }

  /* ── Photo corner stickers (shared base) ──
     Three stickers hang off the corners/edges of the photo stack, popping
     in once it's settled: the existing Class of 2030 badge (bottom-right),
     Sundays 12PM (left edge), and Est. 2021 (bottom-left). They live in
     #photo-stickers, a sibling of #polaroid-scale (see markup) — JS mirrors
     the photo's scale value onto it so they still shrink with the photo. */
  .photo-sticker {
    --sticker-size: clamp(92px, 16vh, 124px);
    position: absolute;
    width: var(--sticker-size);
    height: var(--sticker-size);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    text-decoration: none;
    z-index: 22;
    opacity: 0;
    /* Lives on the base rule (not just the fan-triggered override below)
       so it applies both when fanning fades a sticker out AND when
       un-fanning fades it back in — a transition set only on the
       opacity:0 state has nothing to animate back from. */
    transition: opacity 0.25s ease;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.25),
      0 0 0 0px rgba(0, 0, 0, 0);
  }

  .photo-sticker::before {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    border: 1px solid rgba(245, 245, 240, 0.12);
    pointer-events: none;
  }

  .photo-sticker::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--pulse-a);
    opacity: 0;
    pointer-events: none;
  }

  .photo-sticker.is-live {
    animation: badgePopIn 0.65s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
  }

  .photo-sticker.is-breathing {
    opacity: 1;
    transform: scale(1) var(--sticker-tilt, rotate(0deg));
    animation: badgeBreathe 2.8s ease-in-out infinite;
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .photo-sticker:hover {
    transform: scale(1.13) var(--sticker-tilt, rotate(0deg)) !important;
  }

  .photo-sticker.is-breathing::after {
    animation: badgePulseRing 2.8s ease-out infinite;
  }

  /* ── Class of 2030 (unchanged size/position/colors — now stack-relative) ── */
  .sticker-2030 {
    /* Biggest of the three — it carries the most text and is the only
       clickable sticker, so it should read as the primary one. */
    --sticker-size: clamp(140px, 26vh, 200px);
    /* Recomputed from --sticker-size (not hardcoded) so the rotating ring
       text stays proportional to the badge at every breakpoint — this was
       missing after generalizing #class-badge's old --badge-size to the
       shared --sticker-size var, which left the ring using its -65px
       fallback at every size and badly overshooting on small badges. */
    /* Pushed back out to /-2.5 (was pulled in to /-2.85 to protect the
       ring's OUTER edge before .badge-ring had its own overflow:hidden
       clip). Now that outer edge is safely clipped regardless, and the
       real problem turned out to be the ring's INNER edge: bumping
       "Class of" to a bigger, more readable size (see .badge-classof)
       grew the center content enough that its "2030" corners were
       landing on top of the ring letters - not spilling past the badge,
       just colliding with the ring in the middle. Moving the ring
       outward buys back clearance from the center content without
       reopening the outer-edge issue. */
    --ring-r: calc(var(--sticker-size) / -2.4);
    --pulse-a: rgba(240, 169, 61, 0.65);
    bottom: -8%;
    right: -8%;
    background: #E2402F;
    cursor: pointer;
  }

  /* ── Sundays 12PM — left edge ── */
  .sticker-sundays {
    --pulse-a: rgba(111, 163, 176, 0.6);
    --sticker-tilt: rotate(-6deg);
    top: 42%;
    left: -10%;
    transform: translateY(-50%) var(--sticker-tilt);
    background: #F0A93D;
  }

  /* ── Est. 2021 — bottom-left corner ── */
  .sticker-est {
    --pulse-a: rgba(226, 64, 47, 0.55);
    --sticker-tilt: rotate(5deg);
    bottom: -6%;
    left: -8%;
    background: #6FA3B0;
  }

  .sticker-line1 {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    /* Floor raised to 13px (~10pt) — was clamp(7px,1.3vh,10px), which
       never even reached 10pt at its max, let alone its floor. */
    font-size: clamp(13px, 1.6vh, 15px);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* Was rgba(...,0.6) — too faint against the marigold/sky fills, bumped
       up so the label reads instead of nearly disappearing. */
    color: rgba(35, 32, 29, 0.88);
  }

  .sticker-est .sticker-line1 {
    color: rgba(246, 241, 228, 0.95);
  }

  .sticker-line2 {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-size: clamp(16px, 3.2vh, 24px);
    font-weight: 800;
    line-height: 1;
    color: #23201D;
  }

  .sticker-est .sticker-line2 {
    color: #F6F1E4;
  }

  @keyframes badgePopIn {
    0%   { opacity: 0; transform: scale(0.72) var(--sticker-tilt, rotate(-8deg)); }
    65%  { opacity: 1; transform: scale(1.08) var(--sticker-tilt, rotate(2deg)); }
    82%  { transform: scale(0.97) var(--sticker-tilt, rotate(0deg)); }
    100% { opacity: 1; transform: scale(1) var(--sticker-tilt, rotate(0deg)); }
  }

  .sticker-sundays.is-live {
    animation-name: badgePopInSundays;
  }
  @keyframes badgePopInSundays {
    0%   { opacity: 0; transform: translateY(-50%) scale(0.72) var(--sticker-tilt); }
    65%  { opacity: 1; transform: translateY(-50%) scale(1.08) var(--sticker-tilt); }
    82%  { transform: translateY(-50%) scale(0.97) var(--sticker-tilt); }
    100% { opacity: 1; transform: translateY(-50%) scale(1) var(--sticker-tilt); }
  }

  @keyframes badgeBreathe {
    0%, 100% {
      box-shadow:
        0 4px 20px rgba(0, 0, 0, 0.25),
        0 0 0 0px var(--pulse-a);
    }
    50% {
      box-shadow:
        0 6px 32px rgba(0, 0, 0, 0.18),
        0 0 0 14px transparent;
    }
  }

  @keyframes badgePulseRing {
    0%   { opacity: 0.65; transform: scale(1); }
    100% { opacity: 0;    transform: scale(1.4); }
  }

  @keyframes badgeRingRotate {
    to { transform: rotate(360deg); }
  }

  .badge-ring {
    position: absolute;
    inset: 0;
    animation: badgeRingRotate 18s linear infinite;
    /* The circular shape here comes only from border-radius, which rounds
       this element's own painted box but does NOT crop children that
       render past that edge. --ring-r keeps the rotating "WELCOME" text
       within a few px of the edge by design (it's a ring hugging the
       inside of the badge), which leaves zero margin for glyph ink that
       extends past its own box, or the badge's hover/breathing scale
       animations — any of which pushes letters visibly outside the
       circle with nothing to stop them. Clipping here (not on
       .photo-sticker itself) contains just the ring text, leaving the
       ::after pulse ring — which deliberately extends past the edge —
       unaffected. */
    border-radius: 50%;
    overflow: hidden;
  }

  .badge-ring span {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -0.5em 0 0 -0.5em;
    width: 1em;
    height: 1em;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: clamp(7px, 1.3vh, 10px);
    font-weight: 600;
    color: #F6F1E4;
    text-transform: uppercase;
    line-height: 1;
    transform-origin: center center;
    transform: rotate(calc(var(--a) * 1deg)) translateY(var(--ring-r, -65px));
  }

  .badge-center-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    pointer-events: none;
    user-select: none;
  }

  .badge-classof {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    /* Was clamp(6px,1.2vh,9px) - never even reached 10pt. Letter-spacing
       pulled in from 0.22em to 0.13em at the same time: "CLASS OF" is
       longer than the old "CLASS", so keeping the wider tracking at this
       bigger size would start crowding the badge's edge.
       Max pulled back in from 15px to 13px - at 15px the combined
       "Class of" + "2030" block grew tall/wide enough to collide with
       the rotating ring text (see --ring-r above), not just the badge's
       outer edge. 13px still clears the 10pt floor. */
    font-size: clamp(11px, 1.6vh, 13px);
    font-weight: 600;
    letter-spacing: 0.13em;
    color: rgba(246, 241, 228, 0.7);
    text-transform: uppercase;
  }

  .badge-year-num {
    font-family: 'Unbounded', system-ui, sans-serif;
    /* Max pulled in from 28px to 24px, same reason as .badge-classof
       above - the two together were tall/wide enough at 28px to collide
       with the ring text at typical phone heights (measured via
       getBoundingClientRect, not eyeballed - the "2030" corner landed
       inside the ring's inner edge). */
    font-size: clamp(16px, 2.6vh, 21px);
    font-weight: 800;
    font-style: normal;
    color: #F6F1E4;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  /* Short viewport / high-DPI scaling handled dynamically by JS */

  /* ── Mobile ── */
  @media (max-width: 767px) {
    #polaroid-stack {
      --card-w: clamp(220px, 78vw, 380px);
    }

    #text-wrapper {
      /* width:auto here shrink-to-fits absolutely-positioned content to
         roughly one word wide instead of filling max-width, which forced
         "Silicon Valley College Church" onto 4 cramped lines. Give it an
         explicit width so wrapping is based on the real available space. */
      width: 100%;
      max-width: 85vw;
      padding: 0 16px;
    }

    /* Unbounded runs much wider per-character than the previous Instrument
       Sans treatment — sized so "Silicon Valley" / "College Church" each
       fit one line at common phone widths. Deliberately no white-space:
       nowrap here: combined with this span's auto/shrink-to-fit width, it
       hit a real browser bug where the box width gets stuck at the
       pre-font-swap (fallback font) measurement while the Unbounded text
       itself renders at its full, wider size — box and content disagree,
       and the overflow gets clipped instead of visible. Letting it wrap
       naturally means a tight viewport softly wraps to a second line
       instead of clipping text off the edge. */
    .hero-line1 {
      font-size: clamp(1.1rem, 4.9vw, 1.5rem);
    }

    .hero-line2 {
      font-size: clamp(0.65rem, 2.9vw, 0.95rem);
    }

    .photo-sticker {
      --sticker-size: clamp(92px, 16vh, 122px);
    }

    /* Keep the size hierarchy on mobile too — 2030 stays the biggest */
    .sticker-2030 {
      --sticker-size: clamp(106px, 18vh, 144px);
    }

    .sticker-line1 { font-size: clamp(13px, 1.5vh, 14px); }
    .sticker-line2 { font-size: clamp(14px, 2.6vh, 18px); }
  }

  /* Short mobile viewports (e.g. iPhone SE): the headline plus the
     photo stack don't both fit even at the dynamic scale-down floor, so
     compress the headline further here rather than let them collide. */
  @media (max-width: 767px) and (max-height: 700px) {
    #text-wrapper {
      top: 1%;
    }

    .hero-line1 {
      font-size: clamp(0.95rem, 5.1vw, 1.4rem);
    }

    .hero-line2 {
      font-size: clamp(0.58rem, 3.1vw, 0.83rem);
    }

    /* Smaller stickers on short viewports — the photo itself is already
       scaled down here (see the JS shrink math), so the corner stickers
       need to shrink to match instead of overwhelming it. */
    .photo-sticker {
      --sticker-size: clamp(74px, 12vh, 100px);
    }

    .sticker-2030 {
      --sticker-size: clamp(84px, 14vh, 114px);
    }

    .badge-ring span { font-size: 8px; }
    .badge-classof { font-size: 9px; }
    .badge-year-num { font-size: 11px; }
    .sticker-line1 { font-size: 13px; }
    .sticker-line2 { font-size: 14px; }
  }
</style>

<script>
  // ── Photo pool — read optimized URLs from the data attribute ──
  const ALL_PHOTOS: string[] = JSON.parse(
    document.getElementById('polaroid-stack')!.dataset.photos!
  );

  // Fisher-Yates shuffle
  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // Fan: flat horizontal spread, wide enough to see each photo fully
  const FAN_X = [-900, -300, 300, 900];

  function fanTransform(i: number): string {
    return `translate(${FAN_X[i]}px, 0px)`;
  }

  // Wrap in astro:page-load so it re-runs on View Transitions navigation
  document.addEventListener('astro:page-load', () => {
    const cards      = Array.from(document.querySelectorAll<HTMLElement>('.polaroid-card'));
    const scaleEl    = document.getElementById('polaroid-scale');
    const stickersEl = document.getElementById('photo-stickers');
    const breatheEl  = document.getElementById('polaroid-breathe');
    const stackEl    = document.getElementById('polaroid-stack');
    const textWrap   = document.getElementById('text-wrapper');

    // Bail if we're not on the homepage
    if (!cards.length || !scaleEl || !stickersEl || !breatheEl || !stackEl || !textWrap) return;

    // Reset DOM state (View Transitions preserves classes/styles from previous visit)
    scaleEl.style.transform = '';
    stickersEl.style.transform = '';
    stackEl.style.top = '';
    stackEl.classList.remove('settled');
    delete stackEl.dataset.dynScale;
    breatheEl.classList.remove('breathing', 'fanned');
    textWrap.classList.remove('visible');
    document.querySelectorAll<HTMLElement>('.hero-line1, .hero-line2').forEach(el => el.classList.remove('visible'));
    const stickers = Array.from(document.querySelectorAll<HTMLElement>('.photo-sticker'));
    stickers.forEach(s => s.classList.remove('is-live', 'is-breathing'));
    const footer = document.querySelector('footer');
    if (footer) footer.classList.remove('is-visible');

    // Assign shuffled photos to the 4 static cards
    const picked = shuffle(ALL_PHOTOS).slice(0, cards.length);
    cards.forEach((card, i) => {
      const img = card.querySelector('img')!;
      img.src = picked[i];
    });

    // ── Drop cards in one by one, store stack transform ──
    cards.forEach((card, i) => {
      const dx  = +(Math.random() * 16 - 8).toFixed(2);
      const dy  = +(Math.random() * 16 - 8).toFixed(2);
      const rot = +(Math.random() * 12 - 6).toFixed(2);

      const stackTransform = `translate(${dx}px, ${dy}px) rotate(${rot}deg)`;
      card.dataset.stack   = stackTransform;

      card.style.zIndex    = String(i + 1);
      card.style.transition = 'none';
      card.style.transform = `translate(${dx}px, ${dy - 80}px) rotate(${rot}deg)`;
      card.style.opacity   = '0';

      setTimeout(() => {
        card.style.transition = 'transform 0.13s cubic-bezier(0.34, 1.3, 0.64, 1), opacity 0.08s ease';
        card.style.opacity    = '1';
        card.style.transform  = stackTransform;
      }, i * 160 + 60);
    });

    // ── 0.7s: shrink — scale dynamically based on available viewport space ──
    // The text is already in the DOM (opacity 0) so we can measure its height.
    setTimeout(() => {
      const heroEl  = stackEl.parentElement as HTMLElement;
      const heroH   = heroEl.getBoundingClientRect().height;
      const heroTop = heroEl.getBoundingClientRect().top;
      const textBottom = textWrap.getBoundingClientRect().bottom - heroTop;
      const cardH   = stackEl.offsetHeight;
      const gap     = 32;   // min space between text and card top edge
      const bottomPad = 16; // min space above hero bottom edge

      const availableH = heroH - textBottom - gap - bottomPad;
      // -30px / floor lowered from 0.28: individual cards jitter beyond the
      // base scaled size (see repositioning step below), and on short mobile
      // viewports the headline can legitimately need the photo smaller than
      // 0.28 to avoid overlapping it.
      const scale = Math.min(0.55, Math.max(0.16, (availableH - 30) / cardH));

      scaleEl.style.transform = `scale(${scale})`;
      stickersEl.style.transform = `scale(${scale})`;
      stackEl.dataset.dynScale = String(scale);
      // The invisible hover-zone below (#polaroid-stack.settled::after) is
      // sized off this scale via --dyn-scale, so its footprint tracks the
      // photo's actual on-screen size instead of always assuming full
      // scale — see the CSS comment for why that mismatch mattered.
      stackEl.style.setProperty('--dyn-scale', String(scale));
    }, 700);

    // ── 1.5s: text appears, stack repositions to center in remaining space ──
    const line1 = document.querySelector<HTMLElement>('.hero-line1')!;
    const line2 = document.querySelector<HTMLElement>('.hero-line2')!;

    setTimeout(() => {
      textWrap.classList.add('visible');
      line1.classList.add('visible');

      requestAnimationFrame(() => {
        const heroEl  = stackEl.parentElement as HTMLElement;
        const heroRect = heroEl.getBoundingClientRect();
        const heroH   = heroRect.height;
        const textBottom = textWrap.getBoundingClientRect().bottom - heroRect.top;
        const scale   = parseFloat(stackEl.dataset.dynScale || '0.55');
        // +30px buffer: individual cards jitter up to ±8px translate / ±6deg
        // rotate on top of the base scaled size, so the true visual footprint
        // is a bit bigger than offsetHeight * scale alone accounts for.
        const visualH = stackEl.offsetHeight * scale + 30;
        const gap     = 24;
        const bottomPad = 16;

        // Position the scaled card in the space between text and hero bottom.
        // Not a straight 50/50 center: a smaller headline (see hero-line1/2
        // font-size) leaves a lot more slack here now, and centering that
        // slack evenly reads as a big dead gap under "College Church".
        // Bias toward the top of the available range instead.
        const spaceTop    = textBottom + gap;
        const spaceBottom = heroH - bottomPad;

        // Clamp: card top must clear text, card bottom must stay in hero
        const minCenter = spaceTop + visualH / 2;
        const maxCenter = spaceBottom - visualH / 2;
        const centerY   = minCenter + (maxCenter - minCenter) * 0.25;
        const finalCenter = Math.max(minCenter, Math.min(centerY, maxCenter));

        stackEl.style.top = (finalCenter / heroH * 100) + '%';
      });
    }, 1500);

    setTimeout(() => {
      line2.classList.add('visible');
    }, 1850);

    // ── 3.0s–3.4s: corner stickers pop in, staggered, once the photo has
    //    settled. Only Class of 2030 keeps pulsing afterward — it's the
    //    clickable one; Sundays/Est. just pop in once and hold still. ──
    const popSticker = (el: HTMLElement | null, delay: number, breathe: boolean) => {
      if (!el) return;
      setTimeout(() => {
        el.classList.add('is-live');
        if (breathe) setTimeout(() => el.classList.add('is-breathing'), 1100);
      }, delay);
    };
    popSticker(document.getElementById('sticker-sundays'), 3000, false);
    popSticker(document.getElementById('class-badge'), 3200, true);
    popSticker(document.getElementById('sticker-est'), 3400, false);

    setTimeout(() => {
      const footer = document.querySelector('footer');
      if (footer) footer.classList.add('is-visible');
    }, 3200);

    // ── 2.6s: settled — start breathing + enable fan (desktop) or swipe (mobile) ──
    setTimeout(() => {
      stackEl.classList.add('settled');
      breatheEl.classList.add('breathing');

      const isMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (isMouse) {
        // ── Desktop: hover to fan ──
        let leaveTimer: ReturnType<typeof setTimeout> | null = null;

        stackEl.addEventListener('mouseenter', () => {
          if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
          breatheEl.classList.add('fanned');
          cards.forEach((card, i) => {
            card.style.transition = `transform 0.45s cubic-bezier(0.34, 1.15, 0.64, 1) ${i * 30}ms`;
            card.style.transform  = fanTransform(i);
          });
        });

        stackEl.addEventListener('mouseleave', () => {
          leaveTimer = setTimeout(() => {
            breatheEl.classList.remove('fanned');
            cards.forEach((card) => {
              card.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
              card.style.transform  = card.dataset.stack!;
            });
          }, 80);
        });
      } else {
        // ── Mobile: swipe to cycle through cards ──
        // order[0] = bottom card, order[last] = top card
        const order: number[] = cards.map((_, i) => i);

        const setZIndices = () => {
          order.forEach((cardIdx, slot) => {
            cards[cardIdx].style.zIndex = String(slot + 1);
          });
        };
        setZIndices();

        let touchStartX = 0;
        let touchStartY = 0;
        let isDragging  = false;
        let isAnimating = false;
        const THRESHOLD = 80;

        const snapBack = () => {
          const topCard = cards[order[order.length - 1]];
          topCard.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.2, 0.64, 1)';
          topCard.style.transform  = topCard.dataset.stack!;
          breatheEl.classList.remove('fanned');
        };

        stackEl.addEventListener('touchstart', (e: TouchEvent) => {
          if (isAnimating) return;
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          isDragging  = false;
        }, { passive: true });

        stackEl.addEventListener('touchmove', (e: TouchEvent) => {
          if (isAnimating) return;
          const dx = e.touches[0].clientX - touchStartX;
          const dy = e.touches[0].clientY - touchStartY;

          // Let vertical scrolls pass through untouched
          if (!isDragging && Math.abs(dy) > Math.abs(dx)) return;

          isDragging = true;
          e.preventDefault();

          breatheEl.classList.add('fanned'); // pause breathing while dragging
          const topCard = cards[order[order.length - 1]];
          const rot = dx * 0.07;
          topCard.style.transition = 'none';
          topCard.style.transform  = `translate(${dx}px, ${Math.abs(dx) * 0.05}px) rotate(${rot}deg)`;
        }, { passive: false });

        stackEl.addEventListener('touchcancel', () => {
          if (!isDragging) return;
          isDragging = false;
          snapBack();
        }, { passive: true });

        stackEl.addEventListener('touchend', (e: TouchEvent) => {
          if (!isDragging) return;
          isDragging = false;

          const dx      = e.changedTouches[0].clientX - touchStartX;
          const topCard = cards[order[order.length - 1]];

          if (Math.abs(dx) >= THRESHOLD) {
            isAnimating = true;
            const dir   = dx > 0 ? 1 : -1;

            // Flick the card off screen
            topCard.style.transition = 'transform 0.36s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.36s ease';
            topCard.style.transform  = `translate(${dir * 520}px, 24px) rotate(${dir * 22}deg)`;
            topCard.style.opacity    = '0';

            setTimeout(() => {
              // Silently reset card, then move it to the bottom of the stack
              topCard.style.transition = 'none';
              topCard.style.transform  = topCard.dataset.stack!;
              topCard.style.opacity    = '1';

              // Cycle: top card becomes bottom card
              const popped = order.pop()!;
              order.unshift(popped);
              setZIndices();

              breatheEl.classList.remove('fanned');
              isAnimating = false;
            }, 400);
          } else {
            snapBack();
          }
        }, { passive: true });
      }
    }, 2600);
  });
</script>
