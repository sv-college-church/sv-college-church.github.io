---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import { getHighlightedEvents } from '../lib/events';
import sundayWelcomeTableBalloonArch from '../assets/images/gather/sunday-welcome-table-balloon-arch.jpg';
import sundayStudentsEnteringDoorway from '../assets/images/gather/sunday-students-entering-doorway.jpg';
import sundaySpeakerTitleScreen from '../assets/images/gather/sunday-speaker-title-screen.jpg';
import sundayCrowdWideShot from '../assets/images/gather/sunday-crowd-wide-shot.jpg';
import sundayLeadersLineup from '../assets/images/gather/sunday-leaders-lineup.jpg';
import sundayWorshipBandSinging from '../assets/images/gather/sunday-worship-band-singing.jpg';
import sundayWorshipLyricsScreen from '../assets/images/gather/sunday-worship-lyrics-screen.jpg';
import sundayPreachingEphesiansWide from '../assets/images/gather/sunday-preaching-ephesians-wide.jpg';
import sundayMealLineFriends from '../assets/images/gather/sunday-meal-line-friends.jpg';
import sundayPanoramaFullRoom from '../assets/images/gather/sunday-panorama-full-room.jpg';
import sundayWelcomeTeamPortrait from '../assets/images/gather/sunday-welcome-team-portrait.jpg';
import sundayOutdoorInfoTable from '../assets/images/gather/sunday-outdoor-info-table.jpg';
import sundayThreeFriendsLaughing from '../assets/images/gather/sunday-three-friends-laughing.jpg';
import sundaySpeakerPodiumBalloon from '../assets/images/gather/sunday-speaker-podium-balloon.jpg';
import sundayWorshipCrowdClose from '../assets/images/gather/sunday-worship-crowd-close.jpg';
import sundayFriendsMinglingDiverseGroup from '../assets/images/gather/sunday-friends-mingling-diverse-group.jpg';

const bannerPhotos = [
  { src: sundayWelcomeTableBalloonArch, alt: 'Students checking in at the SVC welcome table under a balloon arch' },
  { src: sundayWelcomeTeamPortrait, alt: 'Welcome team at the SVC College Church table under a balloon arch' },
  { src: sundayStudentsEnteringDoorway, alt: 'Students walking in together through the entrance gate' },
  { src: sundayOutdoorInfoTable, alt: 'Students gathered around an outdoor welcome table' },
  { src: sundaySpeakerTitleScreen, alt: 'Speaker addressing the room under the Sunday Gathering title screen' },
  { src: sundayWorshipBandSinging, alt: 'Worship band leading the congregation in song' },
  { src: sundayCrowdWideShot, alt: 'Full room of students seated for the Sunday gathering' },
  { src: sundayThreeFriendsLaughing, alt: 'Friends laughing together between services' },
  { src: sundayWorshipLyricsScreen, alt: 'Congregation singing along with worship lyrics on screen' },
  { src: sundayFriendsMinglingDiverseGroup, alt: 'Students mingling and laughing together' },
  { src: sundayPreachingEphesiansWide, alt: 'Pastor teaching from Ephesians 4 during Sunday service' },
  { src: sundaySpeakerPodiumBalloon, alt: 'Speaker addressing the congregation from the podium' },
  { src: sundayLeadersLineup, alt: 'Leaders and volunteers introduced at the front of the room' },
  { src: sundayWorshipCrowdClose, alt: 'Students worshiping together during Sunday service' },
  { src: sundayMealLineFriends, alt: 'Students serving themselves a meal together after service' },
  { src: sundayPanoramaFullRoom, alt: 'Panoramic view of the full room gathered for Sunday service' },
];

const hasUpcoming = (await getHighlightedEvents()).length > 0;
const pageUrl = new URL('/gather', Astro.site).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Gathering', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    '@id': `${pageUrl}#sunday-gathering`,
    name: 'SVC Sunday Gathering',
    description: 'Weekly Sunday gathering for college students and young adults from across Silicon Valley.',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    eventSchedule: {
      '@type': 'Schedule',
      byDay: 'https://schema.org/Sunday',
      startTime: '12:00',
      endTime: '13:30',
      repeatFrequency: 'P1W',
    },
    location: {
      '@type': 'Place',
      name: 'SVC Student Center',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1700 Duane Ave',
        addressLocality: 'Santa Clara',
        addressRegion: 'CA',
        postalCode: '95054',
        addressCountry: 'US',
      },
    },
    organizer: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
  },
];
---

<BaseLayout title="Gathering | Silicon Valley College Church" description="Join us Sundays at 12 PM in San Jose. A college church gathering young adults and students from across Silicon Valley." structuredData={structuredData}>
  <div class="page-shell">
  <Nav />
  <main id="main-content" class="bg-cream pt-20 md:pt-32 flex-1">

    <div class="hero-fill">

    <!-- Hero -->
    <section class="py-12 text-center md:py-16">
      <h1 class="font-display font-bold uppercase leading-none text-charcoal" style="font-size: clamp(2.1rem, min(4.6vw, 7vh), 4.6rem);">
        SVC Sundays
      </h1>
    </section>

    <!-- WHEN + WHERE side by side -->
    <section class="when-where border-t border-charcoal/10">
      <!-- Map -->
      <div class="map-col" data-animate>
        <iframe
          class="map-embed"
          title="Map to SVC Student Center"
          src="https://www.google.com/maps?q=SVC+Student+Center,+1700+Duane+Ave,+Santa+Clara,+CA+95054&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Info -->
      <div class="info-col" data-animate>
        <div class="info-content">
          <p class="info-lead">
            SVC meets every <strong>Sunday</strong> at the <strong>SVC Student Center</strong>, 1700 Duane Ave, Santa Clara, CA 95054.
          </p>
          <p class="info-lead">
            Rides will be provided from <strong><a href="https://www.google.com/maps/search/?api=1&query=Washburn+Hall+San+Jose+State+University" target="_blank" rel="noopener noreferrer" class="quiet-link">Washburn Hall</a></strong> at <strong>11:30am</strong>.
          </p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=SVC+Student+Center,+1700+Duane+Ave,+Santa+Clara,+CA+95054"
            target="_blank"
            rel="noopener noreferrer"
            class="directions-button"
            id="directions-link"
          >
            Get Directions
          </a>
        </div>
      </div>
    </section>

    <!-- Rolling photo banner -->
    <section class="photo-banner" aria-label="Photos from SVC Sundays">
      <div class="photo-track">
        {[...bannerPhotos, ...bannerPhotos].map((photo) => (
          <div class="photo-item">
            <Image src={photo.src} alt={photo.alt} width={640} height={427} loading="eager" />
          </div>
        ))}
      </div>
    </section>

    {hasUpcoming && (
      <a href="#upcoming-events" class="coming-up-trigger">
        <span class="coming-up-label">Coming Up</span>
        <span class="coming-up-arrow" aria-hidden="true">↓</span>
      </a>
    )}

    </div>

    <UpcomingEvents />

  </main>
  <Footer />
  </div>
</BaseLayout>

<style>
  .page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Fill the viewport with the hero/info above the fold;
     the "Coming Up" trigger sits at the bottom (margin-top: auto).
     --banner-height is set on :root by EventBanner.astro (0 when no banner). */
  .hero-fill {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 8rem - var(--banner-height, 0px)); /* nav clearance: pt-32 on md+ */
  }
  /* On mobile the hero/when/where naturally exceeds the viewport,
     so we don't try to glue the trigger to the bottom — it just sits
     after the content. */
  @media (max-width: 768px) {
    .hero-fill { min-height: 0; }
  }

  .coming-up-trigger {
    margin-top: auto;
    padding: 1.5rem 0 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: rgb(35 32 29);
    transition: opacity 0.2s ease;
  }
  .coming-up-trigger:hover { opacity: 0.7; }
  .coming-up-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    /* 0.55 alpha measured at 3.58:1 against the cream background — below
       the 4.5:1 AA minimum for this text size. Bumped to 0.68 (5.3:1) for
       a real margin, not a bare pass. */
    color: rgba(35,32,29,0.68);
  }
  .coming-up-arrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1;
    color: #E2402F;
    animation: nudge 2.4s ease-in-out infinite;
  }

  /* ── WHEN + WHERE side by side ── */
  .when-where {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    min-height: 40vh;
    padding: 3rem;
  }

  .map-col {
    height: 100%;
    min-height: 320px;
    max-width: 26rem;
    flex: 1 1 26rem;
  }

  .map-embed {
    width: 100%;
    height: 100%;
    min-height: 320px;
    border: 0;
    border-radius: 14px;
  }

  .info-col {
    display: flex;
    justify-items: center;
    text-align: left;
    padding: 0 1rem;
    max-width: 26rem;
    flex: 1 1 26rem;
  }

  .info-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .quiet-link {
    color: inherit;
    text-decoration: none;
  }
  .quiet-link:hover,
  .quiet-link:focus-visible {
    text-decoration: underline;
  }

  /* ── Reveal (data-animate) — visible by default; see global.css for the
     .not-yet-visible gating that BaseLayout.astro applies via JS. ── */
  [data-animate] {
    transition:
      opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate].not-yet-visible {
    opacity: 0;
    transform: translateY(28px);
  }

  /* ── Section label ── */
  .section-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgb(35 32 29 / 0.60);
    margin-bottom: 1.75rem;
  }

  /* When / Where labels */
  .info-col .section-label {
    font-size: clamp(2rem, 4vw, 4.5rem);
    font-weight: 900;
    letter-spacing: 0.18em;
    color: rgb(35 32 29 / 0.50);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .what-inner .section-label {
    letter-spacing: 0.18em;
    color: rgb(35 32 29 / 0.65);
    margin-bottom: 2rem;
  }

  /* ── Info prose ── */
  .info-lead {
    font-family: 'Instrument Sans', sans-serif;
    /* Was clamp(1.15rem, 1.8vw, 1.6rem) — at its max (25.6px) paired
       with 800-weight <strong> runs (every date/time/place in this
       text), it read as a heading instead of body copy. Brought in
       line with the site's other body-text sizing (e.g. .cg-body). */
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgb(35 32 29 / 0.85);
    max-width: 26rem;
  }

  /* Adjacent-sibling only, so this doesn't also push the directions
     button down — that already has its own margin-top. */
  .info-lead + .info-lead {
    margin-top: 1rem;
  }

  .info-lead strong {
    font-weight: 700;
    color: rgb(35 32 29);
  }

  /* ── Directions button ── */
  .directions-button {
    display: inline-block;
    background: rgb(35 32 29);
    color: #F6F1E4;
    border-radius: 6px;
    padding: 0.9rem 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    margin-top: 1.75rem;
    transition: opacity 0.2s ease;
  }

  .directions-button:hover {
    opacity: 0.8;
  }

  /* ── Rolling photo banner ── */
  .photo-banner {
    overflow: hidden;
    padding: 2rem 0;
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .photo-track {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    animation: scroll-photos 46s linear infinite;
  }

  .photo-banner:hover .photo-track {
    animation-play-state: paused;
  }

  .photo-item {
    flex: 0 0 auto;
    width: 320px;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    overflow: hidden;
  }

  .photo-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes scroll-photos {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .photo-item {
      width: 220px;
    }
  }

  /* ── Scroll hint ── */
  .scroll-hint {
    display: flex;
    justify-content: center;
    padding: 1rem 0;
  }

  .scroll-arrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-style: italic;
    font-size: 2rem;
    color: #E2402F;
    text-decoration: none;
    animation: nudge 2.4s ease-in-out infinite;
    transition: opacity 0.2s ease;
    line-height: 1;
  }

  .scroll-arrow:hover {
    opacity: 0.7;
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50%       { transform: translateY(5px); opacity: 1; }
  }

  /* ── WHAT section ── */
  .reveal-section {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem;
  }

  .reveal-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-rule {
    width: 1px;
    height: 3.5rem;
    background: rgb(35 32 29 / 0.18);
    margin-bottom: 1.75rem;
  }

  .what-inner {
    max-width: 60rem;
  }

  .body-text {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    font-style: normal;
    font-weight: 600;
    line-height: 1.75;
    color: rgb(35 32 29 / 0.82);
    margin-bottom: 3rem;
  }

  .cta-button {
    display: inline-block;
    border: 1px solid rgb(35 32 29);
    padding: 0.8rem 2.75rem;
    border-radius: 10px;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(35 32 29);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .cta-button:hover {
    background: rgb(35 32 29);
    color: #F6F1E4;
  }

  /* ── Short/full label switching ── */
  .label-short { display: none; }

  /* ── Mobile: stack when/where + compact banner ── */
  @media (max-width: 640px) {
    .when-where {
      flex-direction: column;
      min-height: unset;
      padding: 2rem 1.5rem;
      gap: 2rem;
    }

    .map-col {
      min-height: 220px;
      max-width: none;
      flex-basis: auto;
    }

    .info-col {
      max-width: none;
      flex-basis: auto;
    }

    .info-col {
      padding: 0;
      text-align: center;
    }

    .info-content {
      align-items: center;
    }

    .info-lead {
      max-width: none;
    }
  }
</style>

