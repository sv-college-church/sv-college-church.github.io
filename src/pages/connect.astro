---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageUrl = new URL('/connect', Astro.site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Connect', item: pageUrl },
    ],
  },
];
---

<BaseLayout title="Connect | Silicon Valley College Church" description="Get connected at Silicon Valley College Church. Find a small group, meet people from your campus, and plug into community." structuredData={structuredData}>
  <Nav />
  <main id="main-content" class="min-h-screen bg-cream pt-20 md:pt-32 page-enter">
    <section class="py-16 text-center">
      <h1 class="font-display font-bold uppercase leading-none text-charcoal" style="font-size: clamp(2.1rem, min(4.6vw, 7vh), 4.6rem);">
        Connect
      </h1>
    </section>
    <section class="mx-auto max-w-2xl px-4 pb-24 flex justify-center">
      <div class="w-full max-w-[640px]" id="connect-form">
        <!-- Clearstream text-alert signup form. Third-party markup/styles/
             script (not ours to edit) — id="connect-form" kept from the old
             Google Form iframe so the CI accessibility audit's existing
             `.exclude('#connect-form')` still applies to it. -->
        <link media="all" type="text/css" rel="stylesheet" href="https://app.clearstream.io/css/external/form.html.css" />
        <div class="cs_html_form_container">
          <h2>Let&#039;s connect!</h2>
          <p class="cs_html_form_subtitle">New to SVC or looking for ways to get involved? <br />
Sign up here to get connected and receive our text alerts!</p>
          <form class="cs_html_form" action="https://opturl.com/h/0dN1ljwo" method="post" id="cs_html_form_0dN1ljwo" target="_blank">
            <div class="cs_html_form_result"></div>
            <div class="cs_html_form_error"></div>
            <div class="cs_html_form_row"><input type="text" name="mobile_number" placeholder="Mobile Number *" data-country="US" /></div>
            <div class="cs_html_form_row"><input type="text" name="first" placeholder="First Name" /></div>
            <div class="cs_html_form_row"><input type="text" name="last" placeholder="Last Name" /></div>
            <div class="cs_html_form_row"><input type="text" name="email" placeholder="Email Address" /></div>
            <div class="cs_html_form_row">
              <button type="submit">Subscribe</button>
            </div>
            <p class="cs_html_form_terms">Message &amp; data rates may apply. Message frequency varies. <a href="https://clst.io/terms" target="_blank">Terms of Service</a> and <a href="https://clst.io/privacy" target="_blank">Privacy Policy</a>. To opt-out, text STOP at any time. <a href="https://clearstream.io" target="_blank">Software by Clearstream.</a></p>
          </form>
        </div>
        <!-- Note: if a page ever has multiple Clearstream forms, only the
             last one should include form.html.js. -->
        <script is:inline src="https://app.clearstream.io/js/external/form.html.js"></script>
        <script is:inline>var $csj = jQuery.noConflict(true);</script>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-enter {
    animation: pageEnter 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes pageEnter {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Clearstream form overrides ──
     Their stylesheet ships Helvetica Neue at 13px base, noticeably
     smaller than this site's Instrument Sans body copy elsewhere
     (e.g. .cg-blurb runs ~15-19px). Prefixed with #connect-form so
     these win on specificity regardless of DOM/load order against
     their <link> (a flat class selector) — form controls (input,
     button) don't inherit font-family/font-size from ancestors by
     default, so each needs its own rule rather than one on the
     container cascading down. */
  #connect-form .cs_html_form_container {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 15px;
  }

  #connect-form .cs_html_form_container h2 {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 24px;
  }

  #connect-form p.cs_html_form_subtitle {
    font-size: 15px;
  }

  #connect-form .cs_html_form_row > p {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 14px;
  }

  #connect-form .cs_html_form input[type='text'] {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 16px;
  }

  #connect-form .cs_html_form button {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 15px;
  }

  #connect-form .cs_html_form_terms {
    font-size: 12px;
  }
</style>
