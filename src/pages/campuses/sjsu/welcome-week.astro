---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getImage } from 'astro:assets';

import svc04 from '../../../assets/images/community/svc-04.webp';
import svc07 from '../../../assets/images/community/svc-07.webp';
import svc09 from '../../../assets/images/community/svc-09.webp';
import svc11 from '../../../assets/images/community/svc-11.webp';
import svc13 from '../../../assets/images/community/svc-13.webp';
import svc16 from '../../../assets/images/community/svc-16.webp';
import laserTag from '../../../assets/images/community-new/laser-tag.jpg';
import beachGroup from '../../../assets/images/community-new/beach-group.jpg';
import { CONNECT_GROUPS_LIVE, CONNECT_GROUPS_FORM_URL } from '../../../config/flags';

const connectHref = CONNECT_GROUPS_LIVE ? CONNECT_GROUPS_FORM_URL : '/connect';
const connectLabel = CONNECT_GROUPS_LIVE ? 'Sign Up for Connect Groups' : 'Get Connected';

const bgPhotos = await Promise.all(
  [laserTag, svc04, svc07, svc09, beachGroup, svc11, svc13, svc16].map((src) =>
    getImage({ src, width: 480, format: 'webp', quality: 45 })
  )
);

// NOTE: times default to 6:00–9:00 PM per John except where overridden below.
// Locations marked TBA are intentional — to be chosen later.
const horaceMannMapUrl = 'https://maps.app.goo.gl/62onxaD35UY9wsYT6';

// `start`/`end` are ISO-8601 with the Pacific offset, used only for the Event
// JSON-LD below. The visible schedule still renders from `date`/`time`.
const schedule = [
  {
    day: 'SAT',
    date: 'AUG 15',
    name: 'Sports & Pizza',
    sub: 'Move-In Day kickoff',
    location: 'Washburn Hall',
    note: null,
    time: '5:30 – 7:30 PM',
    start: '2026-08-15T17:30:00-07:00',
    end: '2026-08-15T19:30:00-07:00',
  },
  {
    day: 'SUN',
    date: 'AUG 16',
    name: 'Silicon Valley Church',
    sub: 'Worship together',
    location: 'Horace Mann',
    mapUrl: horaceMannMapUrl,
    note: null,
    time: '12:00 – 1:30 PM',
    start: '2026-08-16T12:00:00-07:00',
    end: '2026-08-16T13:30:00-07:00',
  },
  {
    day: 'MON',
    date: 'AUG 17',
    name: 'Laser Tag & Floats',
    sub: 'Event Center',
    location: 'SJSU Event Center',
    note: null,
    time: '7:30 – 9:30 PM',
    start: '2026-08-17T19:30:00-07:00',
    end: '2026-08-17T21:30:00-07:00',
  },
  {
    day: 'TUE',
    date: 'AUG 18',
    name: 'Frosh Social BBQ',
    sub: 'Meet your class',
    location: 'The Place',
    note: null,
    time: '6:00 – 8:00 PM',
    start: '2026-08-18T18:00:00-07:00',
    end: '2026-08-18T20:00:00-07:00',
  },
  {
    day: 'WED',
    date: 'AUG 19',
    name: 'Connect Group Kick Off',
    sub: 'New Student Welcome Night',
    location: 'SU Room 3',
    note: null,
    time: '6:30 – 8:30 PM',
    start: '2026-08-19T18:30:00-07:00',
    end: '2026-08-19T20:30:00-07:00',
  },
  {
    day: 'FRI',
    date: 'AUG 21',
    name: 'SJSU Bonfire',
    sub: "Stories, s'mores, worship",
    location: 'TBA',
    note: null,
    time: '5:30 – 7:30 PM',
    start: '2026-08-21T17:30:00-07:00',
    end: '2026-08-21T19:30:00-07:00',
  },
  {
    day: 'SUN',
    date: 'AUG 23',
    name: 'Silicon Valley Church',
    sub: 'Worship together',
    location: 'Horace Mann',
    mapUrl: horaceMannMapUrl,
    note: null,
    time: '12:00 – 1:30 PM',
    start: '2026-08-23T12:00:00-07:00',
    end: '2026-08-23T13:30:00-07:00',
  },
];

const pageUrl = new URL('/campuses/sjsu/welcome-week', Astro.site).href;

const sjsuPlace = {
  '@type': 'Place',
  name: 'San José State University',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1 Washington Sq',
    addressLocality: 'San Jose',
    addressRegion: 'CA',
    postalCode: '95192',
    addressCountry: 'US',
  },
};

const horaceMannPlace = {
  '@type': 'Place',
  name: 'Horace Mann Elementary School',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '55 N 7th St',
    addressLocality: 'San Jose',
    addressRegion: 'CA',
    postalCode: '95112',
    addressCountry: 'US',
  },
};

const organizer = {
  '@type': 'Organization',
  name: 'Klesis Christian Fellowship at SJSU',
  url: new URL('/campuses/sjsu', Astro.site).href,
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'San José State University',
        item: new URL('/campuses/sjsu', Astro.site).href,
      },
      { '@type': 'ListItem', position: 4, name: 'Welcome Week', item: pageUrl },
    ],
  },
  ...schedule.map((ev) => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `${ev.name} · SJSU Welcome Week`,
    description: `${ev.sub}. Part of Welcome Week at San José State University, hosted by Klesis and Silicon Valley College Church.`,
    startDate: ev.start,
    endDate: ev.end,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: ev.location === 'Horace Mann' ? horaceMannPlace : sjsuPlace,
    organizer,
    url: pageUrl,
    isAccessibleForFree: true,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: pageUrl,
    },
  })),
];
---

<BaseLayout
  title="SJSU Welcome Week 2026 | Klesis Christian Fellowship Events"
  description="Welcome Week at San José State, August 15 to 23, 2026. Sports, pizza, laser tag, a frosh BBQ, and a bonfire with Klesis and Silicon Valley College Church. Free, no sign-up."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content" class="ww-main">

    <!-- ── HERO ── -->
    <section class="ww-hero">
      <div class="ww-photo-strip" aria-hidden="true">
        <div class="ww-photo-track">
          {bgPhotos.map((img) => <img src={img.src} alt="" loading="lazy" class="ww-photo-img" />)}
          {bgPhotos.map((img) => <img src={img.src} alt="" loading="lazy" class="ww-photo-img" />)}
        </div>
        <div class="ww-photo-overlay"></div>
      </div>

      <a href="/campuses/sjsu" class="ww-back-link">← San José State</a>

      <div class="ww-hero-content">
        <p class="ww-eyebrow" data-animate>SJSU · FALL WELCOME</p>
        <h1 class="ww-title" data-animate data-animate-delay="1">Welcome<br />Week</h1>
        <p class="ww-dates" data-animate data-animate-delay="2">August 15 – 23</p>
        <p class="ww-blurb" data-animate data-animate-delay="3">
          Welcome, Class of 2030. Your mentors at Klesis can't wait to meet you.<br />
          Sports, pizza, laser tag, and a bonfire at San José State: this is where it starts.
        </p>
        <div class="ww-ctas" data-animate data-animate-delay="4">
          <a
            href={connectHref}
            class="ww-btn ww-btn-primary"
            target={CONNECT_GROUPS_LIVE ? '_blank' : undefined}
            rel={CONNECT_GROUPS_LIVE ? 'noopener noreferrer' : undefined}
          >{connectLabel}</a>
          <a href="#schedule" class="ww-btn ww-btn-ghost">See the Schedule ↓</a>
          <a
            href="https://www.instagram.com/klesis_sjsu/"
            target="_blank"
            rel="noopener noreferrer"
            class="ww-btn ww-btn-ghost"
          >Follow @klesis_sjsu ↗</a>
        </div>
      </div>
    </section>

    <!-- ── SCHEDULE ── -->
    <section id="schedule" class="ww-schedule">
      <div class="ww-schedule-inner">
        <ol class="ww-list" data-animate>
          {schedule.map((ev) => (
            <li class="ww-row">
              <div class="ww-row-date">
                <span class="ww-row-day">{ev.day}</span>
                <span class="ww-row-datenum">{ev.date}</span>
              </div>
              <div class="ww-row-main">
                <p class="ww-row-name">{ev.name}</p>
                {ev.note && <p class="ww-row-flag">{ev.note}</p>}
              </div>
              <div class="ww-row-meta">
                <p class="ww-row-time">{ev.time}</p>
                <p class="ww-row-loc">
                  {ev.mapUrl ? (
                    <a href={ev.mapUrl} target="_blank" rel="noopener noreferrer" class="ww-row-loc-link">{ev.location}</a>
                  ) : (
                    ev.location
                  )}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  body:has(.ww-main) { background: #F6F1E4; }
  body:has(.ww-main) { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  /* Bitter is loaded sitewide via src/styles/global.css */

  .ww-main { flex: 1; display: flex; flex-direction: column; }

  /* ── HERO ── */
  .ww-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 85vh;
    padding: 12rem 2rem 5rem;
    overflow: hidden;
    background: linear-gradient(180deg, #0F5DA0, #00396E);
    border-bottom: 1px solid rgba(10, 10, 10, 0.08);
  }

  .ww-photo-strip {
    position: absolute;
    top: 128px;
    left: 0;
    right: 0;
    height: clamp(180px, 26vw, 360px);
    overflow: hidden;
    opacity: 0.4;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  .ww-photo-track {
    display: flex;
    gap: 12px;
    height: 100%;
    width: max-content;
    animation: wwScroll 46s linear infinite;
  }

  .ww-photo-img {
    height: 100%;
    width: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 6px;
    filter: grayscale(0.5) brightness(0.85);
    flex-shrink: 0;
  }

  .ww-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 74, 138, 0.55), rgba(0, 74, 138, 0.82));
  }

  @keyframes wwScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .ww-photo-strip { top: 80px; height: 140px; opacity: 0.3; }
  }

  .ww-back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    z-index: 2;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #EAC77E;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ww-back-link:hover { color: #F5DCA0; }

  .ww-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 58rem;
  }

  .ww-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: rgba(234, 199, 126, 0.85);
    margin-bottom: 1.25rem;
  }

  .ww-title {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    color: #EAC77E;
  }

  .ww-dates {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: #F5F5F0;
    margin-top: 1.5rem;
  }

  .ww-blurb {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: clamp(0.9rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    max-width: 62ch;
    margin-top: 1.5rem;
  }

  .ww-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .ww-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    padding: 0.9rem 2.25rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .ww-btn-primary {
    background: #E9C77E;
    color: #004A8A;
  }
  .ww-btn-primary:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  .ww-btn-ghost {
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(234, 199, 126, 0.45);
  }
  .ww-btn-ghost:hover {
    color: #EAC77E;
    border-color: #EAC77E;
  }

  /* ── SCHEDULE ── */
  .ww-schedule {
    padding: 5rem 2rem 6rem;
    display: flex;
    justify-content: center;
  }

  .ww-schedule-inner {
    width: 100%;
    max-width: 52rem;
  }

  .ww-section-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #805E13;
    text-align: center;
  }

  .ww-schedule-note {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: rgba(35, 32, 29, 0.7);
    text-align: center;
    margin-top: 0.75rem;
    margin-bottom: 3.5rem;
  }

  .ww-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .ww-row {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
    transition: opacity 0.3s ease, background 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ww-list:hover .ww-row { opacity: 0.4; }
    .ww-list:hover .ww-row:hover { opacity: 1; background: rgba(128, 94, 19, 0.06); }
  }

  .ww-row-date {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .ww-row-day {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #805E13;
  }

  .ww-row-datenum {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: #23201D;
  }

  .ww-row-name {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    color: #805E13;
  }

  .ww-row-flag {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #805E13;
    margin-top: 0.4rem;
  }

  .ww-row-meta {
    text-align: right;
    line-height: 1.3;
  }

  .ww-row-time {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: #23201D;
    white-space: nowrap;
  }

  .ww-row-loc {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: 0.78rem;
    color: rgba(35, 32, 29, 0.45);
    margin-top: 0.15rem;
    white-space: nowrap;
  }

  .ww-row-loc-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: rgba(35, 32, 29, 0.25);
    transition: color 0.2s ease;
  }
  .ww-row-loc-link:hover { color: #004A8A; }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .ww-hero { padding: 9rem 1.5rem 4rem; }
    .ww-back-link { top: 6.5rem; left: 1.25rem; }

    .ww-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      text-align: left;
      padding: 1.5rem 0.25rem;
    }
    .ww-row-date { flex-direction: row; gap: 0.5rem; align-items: baseline; }
    .ww-row-meta { text-align: left; }
  }
</style>
