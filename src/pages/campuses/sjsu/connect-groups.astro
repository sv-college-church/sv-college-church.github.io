---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { Image } from 'astro:assets';
import { CONNECT_GROUPS_LIVE } from '../../../config/flags';
import sharonMaggy from '../../../assets/images/campuses/connect-groups/sharon-maggy.png';
import tranGabby from '../../../assets/images/campuses/connect-groups/tran-gabby.png';
import justinEstevan from '../../../assets/images/campuses/connect-groups/justin-estevan.png';
import jordanLuc from '../../../assets/images/campuses/connect-groups/jordan-luc.png';

if (!CONNECT_GROUPS_LIVE) {
  return Astro.redirect('/404', 404);
}

// DRAFT — groups are still forming, not yet publicly announced. Leads listed are provisional.
// Default meeting time for groups that haven't set their own yet.
const DEFAULT_MEETING = {
  time: 'Every Wednesday, 6 – 7 PM',
  start: '1st session on Wed, Aug 26',
};

// Ordered guy / girl / guy / girl.
const groups = [
  {
    leads: 'Estevan & Justin',
    consultant: null,
    name: 'Iron Men',
    photo: justinEstevan,
    location: 'SJSU room (TBD)',
    blurb: "Iron Men is a four week collegiate men's group built around one verse: \"Iron sharpens iron, and one man sharpens another\" (Proverbs 27:17). Each week a group of men gather to study Biblical manhood and challenge each other to grow. Iron Men is more than a Bible study; it's the beginning of a brotherhood. We welcome SJSU undergraduate men of any background, whether Christian or not.",
    meetingTime: {
      time: 'Every Thursday, 7 – 8 PM',
      start: '1st session on Thu, Aug 27',
    },
  },
  {
    leads: 'Maggy & Sharon',
    consultant: null,
    name: 'Charcuterie Chats',
    photo: sharonMaggy,
    location: 'Student Union Starbucks',
    blurb: "A weekly club where (beautiful) food sparks connection. Each gathering features a themed charcuterie board paired with meaningful guided conversation inspired by that theme.",
    meetingTime: {
      time: 'Every Wednesday, 7 – 8 PM',
      start: '1st session on Wed, Aug 26',
    },
  },
  {
    leads: 'Luc & Jordan',
    consultant: null,
    name: 'Bible & Biceps',
    photo: jordanLuc,
    location: 'SJSU SRAC',
    blurb: "Hey SJSU Class of 2030! We're Jordan and Luc, and we love hitting the gym and diving into the Bible. We'd love for you to join us for Bible & Biceps—a group where we work out together, grab dinner, and talk through God's Word. Whether you're a practicing Christian or just curious, and whether you've been lifting for years or are a complete beginner, everyone is welcome!",
    meetingTime: {
      time: 'Every Thursday, 6 – 7 PM',
      start: '1st session on Thu, Aug 27',
    },
  },
  {
    leads: 'Gabby & Tran',
    consultant: null,
    name: "Women's Wellness",
    photo: tranGabby,
    location: 'TBD',
    blurb: "Equipping women to care for their whole selves — mind, body & soul.",
    meetingTime: DEFAULT_MEETING,
  },
];
---

<BaseLayout
  title="Connect Groups | SJSU | Silicon Valley College Church"
  description="Sign up for a Connect Group at San José State — small groups to grow in faith and friendship with your class."
  noindex
>
  <Nav />

  <main id="main-content" class="cg-main">

    <!-- ── HERO ── -->
    <section class="cg-hero">
      <a href="/campuses/sjsu/welcome-week" class="cg-back-link">← Welcome Week</a>

      <div class="cg-hero-content">
        <p class="cg-eyebrow">SJSU · CONNECT GROUPS</p>
        <h1 class="cg-title">Connect Groups</h1>
        <p class="cg-blurb">
          Small groups of students, meeting weekly to grow in faith and friendship.<br />
          Sign up now! Groups form during Welcome Week.
        </p>
        <div class="cg-ctas">
          <a href="#signup-form" class="cg-btn cg-btn-primary">Sign Up</a>
        </div>
      </div>
    </section>

    <!-- ── GROUPS ── -->
    <section class="cg-groups">
      <div class="cg-grid">
        {groups.map((g) => (
          <div class="cg-card">
            <h2 class="cg-name">{g.name}</h2>
            <Image src={g.photo} alt={`${g.name} — ${g.leads}`} class="cg-photo" width={960} height={960} />
            <p class="cg-leads">{g.leads}</p>
            {g.consultant && <p class="cg-consultant">Consultant: {g.consultant}</p>}
            <p class="cg-body">
              {g.meetingTime.time}<br />
              {g.location && <>{g.location}<br /></>}
              {g.meetingTime.start}
            </p>
            {g.blurb && (
              <details class="cg-details">
                <summary>About this group</summary>
                <p class="cg-blurb-body">{g.blurb}</p>
              </details>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── SIGN UP ── -->
    <section class="cg-signup" id="signup-form">
      <div class="cg-signup-inner">
        <!-- Google Form iframe (reverted from the Clearstream embed).
             id="connect-form" kept on the iframe itself so the CI
             accessibility audit's existing `.exclude('#connect-form')`
             scope still applies to this third-party embed. -->
        <iframe
          id="connect-form"
          src="https://docs.google.com/forms/d/e/1FAIpQLSc5JIcrm7n63HnFrO2Xv2EqAKDQQOqSnZxF4nhUwFPacNCybw/viewform?embedded=true"
          class="signup-iframe"
          height="1547"
          title="SJSU Connect Groups Sign Up"
          loading="lazy"
        >Loading…</iframe>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    // The Sign Up button is a plain #signup-form anchor, but Astro's
    // ClientRouter (view transitions) intercepts same-page hash links and
    // suppresses the browser's native scroll-to-fragment — confirmed via
    // direct testing (clicking the link, and loading the page with
    // #signup-form already in the URL, both left scrollY at 0). Handling
    // it explicitly instead of relying on native anchor behavior.
    document.addEventListener('astro:page-load', () => {
      const target = document.getElementById('signup-form');
      if (!target) return;

      const link = document.querySelector<HTMLAnchorElement>('a[href="#signup-form"]');
      link?.addEventListener('click', (e) => {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#signup-form');
      });

      if (window.location.hash === '#signup-form') {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  </script>
</BaseLayout>

<style is:global>
  body:has(.cg-main) { background: #F6F1E4; }
  body:has(.cg-main) { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  /* Bitter is loaded sitewide via src/styles/global.css */

  .cg-main { flex: 1; display: flex; flex-direction: column; }

  /* ── HERO ── */
  .cg-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 2rem 3rem;
    border-bottom: 1px solid rgba(35, 32, 29, 0.08);
  }

  .cg-back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #805E13;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cg-back-link:hover { color: #6B4D10; }

  .cg-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 50rem;
  }

  .cg-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #805E13;
    margin-bottom: 1.25rem;
  }

  .cg-title {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.8rem, min(5.2vw, 7vh), 4.6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    color: #004A8A;
    white-space: nowrap;
  }

  .cg-blurb {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: clamp(0.9rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: rgba(35, 32, 29, 0.7);
    margin-top: 1.5rem;
    white-space: nowrap;
  }

  .cg-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .cg-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    padding: 0.9rem 2.25rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cg-btn-primary {
    background: #004A8A;
    color: #ffffff;
  }
  .cg-btn-primary:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  /* ── GROUPS ── */
  .cg-groups {
    padding: 3rem 2rem 5rem;
    max-width: 96rem;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .cg-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .cg-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.25rem 1.75rem;
    gap: 1rem;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 2px 16px rgba(35, 32, 29, 0.07);
  }

  .cg-photo {
    height: 260px;
    width: auto;
    object-fit: contain;
    border-radius: 10px;
  }

  .cg-name {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #805E13;
  }

  .cg-leads {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    /* 0.55 gave 3.72:1 against the white card background — below WCAG
       AA's 4.5:1 minimum for this size/weight. 0.65 clears it (~5.1:1). */
    color: rgba(35, 32, 29, 0.65);
    margin-top: -0.5rem;
  }

  .cg-consultant {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 1.275rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.55);
  }

  .cg-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    font-weight: 500;
    line-height: 1.7;
    color: rgba(35, 32, 29, 0.7);
    max-width: 32ch;
  }

  .cg-details {
    width: 100%;
    margin-top: 0.25rem;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
    padding-top: 1rem;
  }

  .cg-details summary {
    cursor: pointer;
    list-style: none;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #004A8A;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .cg-details summary::-webkit-details-marker { display: none; }
  .cg-details summary::after {
    content: '▾';
    font-size: 0.7rem;
    transition: transform 0.2s ease;
  }
  .cg-details[open] summary::after { transform: rotate(180deg); }

  .cg-blurb-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
    color: rgba(10, 10, 10, 0.7);
    margin-top: 0.9rem;
  }

  @media (max-width: 1024px) {
    .cg-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ── SIGN UP ── */
  .cg-signup {
    display: flex;
    justify-content: center;
    padding: 0 2rem 6rem;
    /* Nav is fixed (h-20/80px mobile, md:h-32/128px desktop, see
       Nav.astro) — this clears it with room to spare when the Sign Up
       button's #signup-form anchor scrolls here. */
    scroll-margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .cg-signup { scroll-margin-top: 9rem; }
  }

  .cg-signup-inner {
    width: 100%;
    max-width: 40rem;
  }

  .signup-iframe {
    width: 100%;
    border: 0;
    border-radius: 12px;
    /* Same shadow value as .cg-card above, for visual consistency. */
    box-shadow: 0 2px 16px rgba(35, 32, 29, 0.07);
  }

  @media (max-width: 640px) {
    .cg-hero { padding: 7rem 1.5rem 2.5rem; }
    .cg-back-link { top: 5.5rem; left: 1.25rem; }
    .cg-title { white-space: normal; }
    .cg-blurb { white-space: normal; }

    .cg-groups { padding: 2.5rem 1.25rem 3.5rem; }

    .cg-grid {
      grid-template-columns: 1fr;
    }
    .cg-card { padding: 2.25rem 1.75rem; }
    .cg-photo { height: 220px; }

    .cg-signup { padding: 0 1.25rem 4rem; }
  }
</style>
