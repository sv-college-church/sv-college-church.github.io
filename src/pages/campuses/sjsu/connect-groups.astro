---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { Image } from 'astro:assets';
import { CONNECT_GROUPS_LIVE } from '../../../config/flags';
import sharonMaggy from '../../../assets/images/campuses/connect-groups/sharon-maggy.png';
import tranGabby from '../../../assets/images/campuses/connect-groups/tran-gabby.png';
import justinEstevan from '../../../assets/images/campuses/connect-groups/justin-estevan.png';
import jordanLuc from '../../../assets/images/campuses/connect-groups/jordan-luc.png';

if (!CONNECT_GROUPS_LIVE) {
  return Astro.redirect('/404', 404);
}

// DRAFT — groups are still forming, not yet publicly announced. Leads listed are provisional.
// Default meeting time for groups that haven't set their own yet.
const DEFAULT_MEETING = 'Every Wednesday · 6:00 – 7:00 PM, starting Wed, Aug 24';

// Ordered girl / guy / guy / girl so the 2x2 grid pairs same-gender groups diagonally.
const groups = [
  {
    leads: 'Sharon & Maggy',
    consultant: null,
    name: 'Charcuterie Chats',
    photo: sharonMaggy,
    meetingTime: DEFAULT_MEETING,
    blurb: null,
  },
  {
    leads: 'Justin & Estevan',
    consultant: null,
    name: 'Iron Men',
    photo: justinEstevan,
    meetingTime: DEFAULT_MEETING,
    blurb: null,
  },
  {
    leads: 'Jordan & Luc',
    consultant: null,
    name: 'Bible & Biceps',
    photo: jordanLuc,
    meetingTime: DEFAULT_MEETING,
    blurb: null,
  },
  {
    leads: 'Tran & Gabby',
    consultant: null,
    name: "Women's Wellness (WW)",
    photo: tranGabby,
    meetingTime: DEFAULT_MEETING,
    blurb: null,
  },
];
---

<BaseLayout
  title="Connect Groups | SJSU | Silicon Valley College Church"
  description="Sign up for a Connect Group at San José State — small groups to grow in faith and friendship with your class."
  noindex
>
  <Nav />

  <main id="main-content" class="cg-main">

    <!-- ── HERO ── -->
    <section class="cg-hero">
      <a href="/campuses/sjsu/welcome-week" class="cg-back-link">← Welcome Week</a>

      <div class="cg-hero-content">
        <p class="cg-eyebrow">SJSU · CONNECT GROUPS</p>
        <h1 class="cg-title">Connect<br />Groups</h1>
        <p class="cg-blurb">
          Small groups of students, meeting weekly to grow in faith and friendship. Sign up now — groups form during Welcome Week.
        </p>
        <div class="cg-ctas">
          <a href="/connect" class="cg-btn cg-btn-primary">Sign Up</a>
        </div>
      </div>
    </section>

    <!-- ── GROUPS ── -->
    <section class="cg-groups">
      <p class="cg-section-label">Fall Groups — Draft</p>
      <div class="cg-grid">
        {groups.map((g) => (
          <div class="cg-card">
            <Image src={g.photo} alt={`${g.name} — ${g.leads}`} class="cg-card-photo" width={640} height={640} />
            <p class="cg-card-name">{g.name}</p>
            <p class="cg-card-leads">{g.leads}</p>
            {g.consultant && <p class="cg-card-consultant">Consultant: {g.consultant}</p>}
            <p class="cg-card-time">{g.meetingTime}</p>
            <p class:list={['cg-card-blurb', { 'is-placeholder': !g.blurb }]}>
              {g.blurb ?? 'Blurb coming soon.'}
            </p>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  body:has(.cg-main) { background: #F5F5F0; }
  body:has(.cg-main) { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  /* Bitter is loaded sitewide via src/styles/global.css */

  .cg-main { flex: 1; display: flex; flex-direction: column; }

  /* ── HERO ── */
  .cg-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding: 12rem 2rem 4rem;
    border-bottom: 1px solid rgba(10, 10, 10, 0.08);
  }

  .cg-back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #805E13;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cg-back-link:hover { color: #6B4D10; }

  .cg-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 44rem;
  }

  .cg-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #805E13;
    margin-bottom: 1.25rem;
  }

  .cg-title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    color: #004A8A;
  }

  .cg-blurb {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: rgba(10, 10, 10, 0.62);
    max-width: 34ch;
    margin-top: 1.5rem;
  }

  .cg-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .cg-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    padding: 0.9rem 2.25rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cg-btn-primary {
    background: #004A8A;
    color: #ffffff;
  }
  .cg-btn-primary:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  /* ── GROUPS ── */
  .cg-groups {
    padding: 5rem 2rem 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cg-section-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #805E13;
    text-align: center;
    margin-bottom: 3rem;
  }

  .cg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 44rem;
  }

  .cg-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 14px;
  }

  .cg-card-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 10px;
  }

  .cg-card-name {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    color: #004A8A;
    margin-top: 0.9rem;
  }

  .cg-card-leads {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: #1A1A1A;
    margin-top: 0.3rem;
  }

  .cg-card-consultant {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    color: rgba(10, 10, 10, 0.55);
    margin-top: 0.5rem;
  }

  .cg-card-time {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #805E13;
    margin-top: 0.75rem;
  }

  .cg-card-blurb {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(10, 10, 10, 0.62);
    margin-top: 0.6rem;
  }

  .cg-card-blurb.is-placeholder {
    font-style: italic;
    color: rgba(10, 10, 10, 0.35);
  }

  @media (max-width: 640px) {
    .cg-hero { padding: 9rem 1.5rem 3rem; }
    .cg-back-link { top: 6.5rem; left: 1.25rem; }

    .cg-grid { grid-template-columns: 1fr; }
    .cg-groups { padding: 3.5rem 1.5rem 4rem; }
  }
</style>
