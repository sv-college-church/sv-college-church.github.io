---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { Image } from 'astro:assets';
import { CONNECT_GROUPS_LIVE, CONNECT_GROUPS_FORM_URL } from '../../../config/flags';
import sharonMaggy from '../../../assets/images/campuses/connect-groups/sharon-maggy.png';
import tranGabby from '../../../assets/images/campuses/connect-groups/tran-gabby.png';
import justinEstevan from '../../../assets/images/campuses/connect-groups/justin-estevan.png';
import jordanLuc from '../../../assets/images/campuses/connect-groups/jordan-luc.png';

if (!CONNECT_GROUPS_LIVE) {
  return Astro.redirect('/404', 404);
}

// DRAFT — groups are still forming, not yet publicly announced. Leads listed are provisional.
// Default meeting time for groups that haven't set their own yet.
const DEFAULT_MEETING = {
  time: 'Every Wednesday, 6 – 7 PM',
  start: 'First session on Wed, Aug 26',
};

// Ordered girl / guy / guy / girl so the 2x2 grid pairs same-gender groups diagonally.
const groups = [
  {
    leads: 'Sharon & Maggy',
    consultant: null,
    name: 'Charcuterie Chats',
    photo: sharonMaggy,
    meetingTime: {
      time: 'Every Wednesday, 7 – 8 PM',
      start: 'First session on Wed, Aug 26',
    },
  },
  {
    leads: 'Justin & Estevan',
    consultant: null,
    name: 'Iron Men',
    photo: justinEstevan,
    meetingTime: {
      time: 'Every Thursday, 7 – 8 PM',
      start: 'First session on Thu, Aug 27',
    },
  },
  {
    leads: 'Jordan & Luc',
    consultant: null,
    name: 'Bible & Biceps',
    photo: jordanLuc,
    meetingTime: {
      time: 'Every Thursday, 6 – 7 PM',
      start: 'First session on Thu, Aug 27',
    },
  },
  {
    leads: 'Tran & Gabby',
    consultant: null,
    name: "Women's Wellness",
    photo: tranGabby,
    meetingTime: DEFAULT_MEETING,
  },
];
---

<BaseLayout
  title="Connect Groups | SJSU | Silicon Valley College Church"
  description="Sign up for a Connect Group at San José State — small groups to grow in faith and friendship with your class."
  noindex
>
  <Nav />

  <main id="main-content" class="cg-main">

    <!-- ── HERO ── -->
    <section class="cg-hero">
      <a href="/campuses/sjsu/welcome-week" class="cg-back-link">← Welcome Week</a>

      <div class="cg-hero-content">
        <p class="cg-eyebrow">SJSU · CONNECT GROUPS</p>
        <h1 class="cg-title">Connect<br />Groups</h1>
        <p class="cg-blurb">
          Small groups of students, meeting weekly to grow in faith and friendship. Sign up now! Groups form during Welcome Week.
        </p>
        <div class="cg-ctas">
          <a href={CONNECT_GROUPS_FORM_URL} target="_blank" rel="noopener noreferrer" class="cg-btn cg-btn-primary">Sign Up</a>
        </div>
      </div>
    </section>

    <!-- ── GROUPS ── -->
    <section class="cg-groups">
      <div class="cg-grid">
        {groups.map((g) => (
          <div class="cg-col">
            <Image src={g.photo} alt={`${g.name} — ${g.leads}`} class="cg-photo" width={960} height={960} />
            <h2 class="cg-label">{g.name}<br />{g.leads}</h2>
            {g.consultant && <p class="cg-consultant">Consultant: {g.consultant}</p>}
            <p class="cg-body">{g.meetingTime.time}<br />{g.meetingTime.start}</p>
          </div>
        ))}
        <div class="cg-divider-v" aria-hidden="true"></div>
        <div class="cg-divider-h" aria-hidden="true"></div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
  body:has(.cg-main) { background: #F6F1E4; }
  body:has(.cg-main) { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  /* Bitter is loaded sitewide via src/styles/global.css */

  .cg-main { flex: 1; display: flex; flex-direction: column; }

  /* ── HERO ── */
  .cg-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding: 12rem 2rem 4rem;
    border-bottom: 1px solid rgba(35, 32, 29, 0.08);
  }

  .cg-back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #805E13;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cg-back-link:hover { color: #6B4D10; }

  .cg-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 44rem;
  }

  .cg-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #805E13;
    margin-bottom: 1.25rem;
  }

  .cg-title {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    color: #004A8A;
  }

  .cg-blurb {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: rgba(35, 32, 29, 0.62);
    max-width: 34ch;
    margin-top: 1.5rem;
  }

  .cg-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .cg-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    padding: 0.9rem 2.25rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cg-btn-primary {
    background: #004A8A;
    color: #ffffff;
  }
  .cg-btn-primary:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  /* ── GROUPS ── */
  .cg-groups {
    padding-top: 5rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .cg-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    grid-template-rows: auto 1px auto;
  }

  .cg-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 3rem;
    gap: 1.25rem;
  }

  .cg-col:nth-child(1) { grid-column: 1; grid-row: 1; }
  .cg-col:nth-child(2) { grid-column: 3; grid-row: 1; }
  .cg-col:nth-child(3) { grid-column: 1; grid-row: 3; }
  .cg-col:nth-child(4) { grid-column: 3; grid-row: 3; }

  .cg-divider-v {
    grid-column: 2;
    grid-row: 1 / 4;
    background: rgba(35, 32, 29, 0.08);
  }

  .cg-divider-h {
    grid-column: 1 / 4;
    grid-row: 2;
    background: rgba(35, 32, 29, 0.08);
  }

  .cg-photo {
    height: 288px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.25rem;
    border-radius: 10px;
  }

  .cg-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.93rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #805E13;
  }

  .cg-consultant {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 1.275rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.55);
  }

  .cg-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1.35rem, 1.95vw, 1.5rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.62);
    max-width: 32ch;
  }

  @media (max-width: 640px) {
    .cg-hero { padding: 9rem 1.5rem 3rem; }
    .cg-back-link { top: 6.5rem; left: 1.25rem; }

    .cg-groups { padding-top: 3.5rem; }

    .cg-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .cg-divider-v, .cg-divider-h { display: none; }
    .cg-col {
      grid-column: 1 !important;
      grid-row: auto !important;
      padding: 3.5rem 2rem;
      border-top: 1px solid rgba(35, 32, 29, 0.08);
    }
    .cg-col:first-child { border-top: none; }
  }
</style>
