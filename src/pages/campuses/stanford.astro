---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import momentLogo from '../../assets/images/campuses/logos/moment.png';
import momentIntl from '../../assets/images/campuses/logos/moment-intl.png';

const pageUrl = new URL('/campuses/stanford', Astro.site).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Stanford University', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#moment`,
    name: 'Moment Christian Fellowship at Stanford',
    alternateName: 'Moment Stanford',
    description: 'A Christian fellowship at Stanford University built around community, Bible study, and discipleship. Open to all Stanford students.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/moment.stanford/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Stanford University' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#moment-intl`,
    name: 'Moment International at Stanford',
    description: 'A fellowship for international students at Stanford University, part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/moment.intl/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Stanford University' },
  },
];
---

<BaseLayout
  title="Moment Stanford | Christian Fellowship & Bible Study"
  description="Moment is a Christian fellowship at Stanford University. Bible study, community, and discipleship for Stanford students, including Moment International for international students."
  structuredData={structuredData}
>
  <Nav />

  <main>

    <section class="hero-section" style="view-transition-name: campus-stanford">
      <a href="/campuses" class="back-link">← Campuses</a>
      <h1 class="school-name">Stanford<br/>University</h1>
      <p class="hero-tagline">A Christian fellowship and Bible study for Stanford students</p>
    </section>

    <section class="groups-section">
      <div class="group-col">
        <Image src={momentLogo} alt="Moment Christian Fellowship logo, Stanford University" class="group-logo" />
        <h2 class="group-label">Moment · Stanford</h2>
        <p class="group-body">A Christian fellowship for Stanford students built around community, Bible study, and discipleship. Modeled after the Acts 2 church and open to all.</p>
        <a href="https://www.instagram.com/moment.stanford/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
      </div>
      <div class="col-divider" aria-hidden="true"></div>
      <div class="group-col">
        <Image src={momentIntl} alt="Moment International logo, Stanford University" class="group-logo" />
        <h2 class="group-label">Moment International · Stanford</h2>
        <p class="group-body">Moment International reaches international students at Stanford with the gospel, a community for those navigating a new country and a new chapter of life.</p>
        <a href="https://www.instagram.com/moment.intl/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #FBF1F1; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
    border-bottom: 1px solid rgba(10, 10, 10, 0.08);
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #A85252;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #833F3F; }

  .school-name {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #A85252;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(10, 10, 10, 0.55);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .groups-section {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
  }

  .col-divider {
    background: rgba(10, 10, 10, 0.08);
    align-self: stretch;
  }

  .group-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 3rem;
    gap: 1.25rem;
  }

  .group-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    opacity: 0.75;
    margin-bottom: 0.25rem;
  }

  .group-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #A85252;
  }

  .group-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(10, 10, 10, 0.62);
    max-width: 36ch;
  }

  .group-link {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #A85252;
    text-decoration: none;
    padding: 0.75rem 2.25rem;
    margin-top: 0.75rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .group-link:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  @media (max-width: 640px) {
    .groups-section {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1px auto;
    }
    .col-divider {
      width: 100%;
      height: 1px;
    }
    .group-col { padding: 3.5rem 2rem; }
  }
</style>
