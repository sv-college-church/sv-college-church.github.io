---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import momentLogo from '../../assets/images/campuses/logos/moment.png';
import momentGrad from '../../assets/images/campuses/logos/moment-grad.png';
import readBibleFlyer from '../../assets/images/events/read-the-bible-stanford.png';
import welcomeNightFlyer from '../../assets/images/events/welcome-night-stanford.png';
import midAutumnFlyer from '../../assets/images/events/mid-autumn-stanford.png';

const pageUrl = new URL('/campuses/stanford', Astro.site).href;
const readBibleSignupUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSfWE3Gt4e66Xd9BsOv2EKAvzWzsyILvL1VITjEA1q4ggbMvzw/viewform';
const welcomeNightSignupUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSf9_K7nXvHtUv-lEJZhHNrastWG-hpPsTqFPAGWmjMnp9xSrg/viewform';
const midAutumnSignupUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSf9_K7nXvHtUv-lEJZhHNrastWG-hpPsTqFPAGWmjMnp9xSrg/viewform';

const faqs = [
  {
    q: 'Is there a Christian fellowship at Stanford?',
    a: 'Yes. Moment is a Christian fellowship at Stanford University, part of Silicon Valley College Church. It is open to every Stanford student, whatever you believe right now.',
  },
  {
    q: 'Is there a group for Stanford graduate students?',
    a: 'Yes. Moment Grad is a fellowship for graduate students at Stanford, focused on genuine community in the context of Christian faith.',
  },
  {
    q: 'Do I have to be a Christian to come?',
    a: 'No. Moment is open to any Stanford student, including students who are not Christian and students who are still working out what they believe.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Stanford University', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#moment`,
    name: 'Moment Christian Fellowship at Stanford',
    alternateName: 'Moment Stanford',
    description: 'A Christian fellowship at Stanford University built around community, Bible study, and discipleship. Open to all Stanford students.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/moment.stanford/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Stanford University' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#moment-grad`,
    name: 'Moment Grad at Stanford',
    description: 'A fellowship for graduate students at Stanford University, part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/moment.stanford/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Stanford University' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Moment Stanford | Christian Fellowship & Bible Study"
  description="Moment is a Christian fellowship at Stanford University. Bible study, community, and discipleship for Stanford students, including Moment Grad for graduate students."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <section class="hero-section" style="view-transition-name: campus-stanford">
      <a href="/campuses" class="back-link">← Campuses</a>
      <h1 class="school-name">Stanford<br/>University</h1>
    </section>

    <section class="groups-section">
      <div class="group-col">
        <Image src={momentLogo} alt="Moment Christian Fellowship logo, Stanford University" class="group-logo" />
        <h2 class="group-label">Moment · Stanford</h2>
        <p class="group-body">A Christian fellowship for Stanford students built around community, Bible study, and discipleship. Open to students from all religious or non-religious backgrounds!</p>
        <a href="https://www.instagram.com/moment.stanford/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
      </div>
      <div class="col-divider" aria-hidden="true"></div>
      <div class="group-col">
        <Image src={momentGrad} alt="Moment Grad logo, Stanford University" class="group-logo" />
        <h2 class="group-label">Moment Grad · Stanford</h2>
        <p class="group-body">Moment Grad is a graduate student group at Stanford focused on building genuine connections in the context of Christian community.</p>
        <a href="https://www.instagram.com/moment.stanford/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
      </div>
    </section>

    <section class="weekly-section">
      <a
        href={readBibleSignupUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="weekly-card"
      >
        <Image
          src={readBibleFlyer}
          alt="Read the Bible for Yourself flyer: Tuesdays, 7-8 PM at CIRCLE (3rd floor of Old Union). Bring your questions, we'll bring the text and snacks. First meeting September 29. Hosted by Moment Christian Fellowship."
          class="weekly-thumb"
        />
        <div class="weekly-body">
          <h2 class="weekly-title">Read the Bible for Yourself</h2>
          <p class="weekly-desc">Tuesdays, 7–8 PM at CIRCLE (3rd floor, Old Union). Bring your questions, we'll bring the text and the snacks. First meeting September 29.</p>
          <span class="weekly-cta">Sign Up ↗</span>
        </div>
      </a>
      <a
        href={welcomeNightSignupUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="weekly-card"
      >
        <Image
          src={welcomeNightFlyer}
          alt="Graduate Student Welcome Night flyer: Tuesday, September 22 at EVGR B170. Hosted by Moment Grad at Stanford."
          class="weekly-thumb"
        />
        <div class="weekly-body">
          <h2 class="weekly-title">Graduate Student Welcome Night</h2>
          <p class="weekly-desc">Tuesday, 9/22 at EVGR B170. Join us to learn more about our group and future community events!</p>
          <span class="weekly-cta">Sign Up ↗</span>
        </div>
      </a>
      <a
        href={midAutumnSignupUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="weekly-card"
      >
        <Image
          src={midAutumnFlyer}
          alt="Mid-Autumn Festival Celebration flyer: Friday, September 25 at EVGR B141. Free Chinese food. Hosted by Moment Grad at Stanford."
          class="weekly-thumb"
        />
        <div class="weekly-body">
          <h2 class="weekly-title">Mid-Autumn Festival Celebration</h2>
          <p class="weekly-desc">Friday, 9/25 at EVGR B141. Celebrate Mid-Autumn Festival with us with free Chinese food!</p>
          <span class="weekly-cta">Sign Up ↗</span>
        </div>
      </a>
    </section>

    <section class="faq-section">
      <h2 class="section-heading">Common questions from Stanford students</h2>
      <div class="faq-accordion">
        {faqs.map((f) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false">
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
    border-bottom: 1px solid rgba(35, 32, 29, 0.08);
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #8C1515;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #6B1010; }

  .school-name {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2.1rem, min(4.6vw, 7vh), 4.6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #8C1515;
  }

  .groups-section {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
  }

  .col-divider {
    background: rgba(35, 32, 29, 0.08);
    align-self: stretch;
  }

  .group-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 3rem;
    gap: 1.25rem;
  }

  .group-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.25rem;
    border-radius: 10px;
  }

  .group-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #8C1515;
  }

  .group-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.7);
    max-width: 36ch;
  }

  .group-link {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #8C1515;
    text-decoration: none;
    padding: 0.75rem 2.25rem;
    margin-top: 0.75rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .group-link:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  @media (max-width: 640px) {
    .groups-section {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1px auto;
    }
    .col-divider {
      width: 100%;
      height: 1px;
    }
    .group-col { padding: 3.5rem 2rem; }
  }

  /* ── Read the Bible for Yourself ── */
  .weekly-section {
    padding: 4rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .weekly-card {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    max-width: 42rem;
    width: 100%;
    background: transparent;
    border: 1px solid #8C1515;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .weekly-card:hover {
    transform: scale(1.015);
  }

  .weekly-thumb {
    flex-shrink: 0;
    width: 110px;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .weekly-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .weekly-title {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: #8C1515;
  }

  .weekly-desc {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(35, 32, 29, 0.75);
  }

  .weekly-cta {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    background: #8C1515;
    padding: 0.55rem 1.2rem;
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .weekly-section { padding: 3rem 1.5rem; }
    .weekly-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem;
    }
    .weekly-thumb { width: 88px; }
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .section-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #8C1515;
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-accordion {
    max-width: 46rem;
    margin: 0 auto;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-item {
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 800;
    color: #23201D;
    transition: color 0.2s ease;
  }
  .accordion-trigger:hover { color: #8C1515; }

  .accordion-icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
    color: #8C1515;
    transition: transform 0.25s ease;
  }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-content p {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.6);
    padding-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .faq-section { padding: 3.5rem 1.5rem; }
    .section-heading { margin-bottom: 2rem; }
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.parentElement!;
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      content.style.maxHeight = !isOpen ? content.scrollHeight + 'px' : '';
    });
  });
</script>
