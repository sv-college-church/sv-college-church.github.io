---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import momentLogo from '../../assets/images/campuses/logos/moment.png';
---

<BaseLayout title="Stanford | Silicon Valley College Church" description="Silicon Valley College Church at Stanford University — campus ministry for Stanford students in Palo Alto.">
  <Nav />

  <main>

    <section class="hero-section" style="view-transition-name: campus-stanford">
      <a href="/campuses" class="back-link">← Campuses</a>
      <Image src={momentLogo} alt="Moment" class="hero-logo" />
      <p class="hero-fellowship">Moment</p>
      <h1 class="school-name">Stanford<br/>University</h1>
    </section>

    <section class="info-grid">
      <div class="info-col">
        <h2 class="info-label">Established</h2>
        <p class="info-value">2021</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Events</h2>
        <a href="https://www.instagram.com/moment.stanford/" target="_blank" rel="noopener noreferrer" class="events-btn">Instagram ↗</a>
      </div>
    </section>

    <section class="about-section">
      <h2 class="info-label">About</h2>
      <p class="about-body">Moment reaches international students at Stanford with the gospel — a community for those navigating a new country and a new chapter of life.</p>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #6B0F0F !important; }
  body { display: flex; flex-direction: column; min-height: 100svh; }

  header {
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  header::before {
    background: rgba(90, 10, 10, 0.97) !important;
  }
  header a { color: rgba(255,255,255,0.75) !important; }
  header a:hover { color: #ffffff !important; }
  .hamburger-bar { background-color: rgba(255,255,255,0.8) !important; }
  .logo-main, .logo-depth { filter: invert(1) brightness(1.1) !important; }

  #mobile-menu nav {
    background: #5A0A0A !important;
    border-color: rgba(255,255,255,0.08) !important;
  }
  #mobile-menu a {
    color: rgba(255,255,255,0.75) !important;
    border-color: rgba(255,255,255,0.08) !important;
  }

  footer {
    background: #5A0A0A !important;
    border-color: rgba(255,255,255,0.1) !important;
  }
  footer p { color: rgba(255,255,255,0.6) !important; }
  footer a { color: rgba(255,255,255,0.6) !important; }
  footer a:hover { color: rgba(255,255,255,0.85) !important; }
  footer .network-logo { filter: none !important; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(210,194,149,0.85);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #D2C295; }

  .hero-logo {
    height: 90px;
    width: auto;
    object-fit: contain;
    opacity: 0.45;
    filter: invert(1);
    margin-bottom: 0.5rem;
  }

  .hero-fellowship {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.25rem;
  }

  .school-name {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #D2C295;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 1rem 3rem 2rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .info-label {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #D2C295;
    margin: 0;
  }

  .info-value {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    color: #ffffff;
  }

  .events-btn {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #6B0F0F;
    background: #ffffff;
    text-decoration: none;
    padding: 0.85rem 2.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .events-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  .about-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 4rem 3rem 7rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 0 3rem;
  }

  .about-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(255,255,255,0.6);
    max-width: 62ch;
    margin: 0;
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      padding: 0 2rem 1rem;
    }
    .info-col { padding: 2rem 1rem; }
    .about-section {
      padding: 3rem 2rem 4rem;
      margin: 0 2rem;
    }
  }
</style>
