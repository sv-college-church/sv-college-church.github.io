---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisSjsu from '../../assets/images/campuses/logos/klesis-sjsu.png';
import fourCorners from '../../assets/images/campuses/logos/4corners.png';
import { CONNECT_GROUPS_LIVE } from '../../config/flags';

const pageUrl = new URL('/campuses/sjsu', Astro.site).href;
const sundayLocation = 'Horace Mann Elementary School, 55 N 7th St, San Jose, CA 95112';

const faqs = [
  {
    q: 'Is there a Christian club at SJSU?',
    a: 'Yes. Klesis Christian Fellowship and 4Corners Christian Fellowship are both officially recognized student organizations at San José State, and both are part of Silicon Valley College Church. Klesis is open to every student on campus. 4Corners is built around international students.',
  },
  {
    q: 'Where can I find a Bible study near San José State?',
    a: `Klesis and 4Corners read the Bible together in small groups on and around campus during the week, and the whole church gathers on Sundays at 12 PM at ${sundayLocation}, a short walk from campus. Weekly times are posted on each club's Instagram.`,
  },
  {
    q: 'Do I have to be a Christian to come?',
    a: 'No. Both clubs are open to any SJSU student, including students who are not Christian and students who are still working out what they believe. Nobody has to sign anything or believe anything to show up.',
  },
  {
    q: 'How do I get connected during Welcome Week?',
    a: 'Welcome Week at SJSU runs August 15 to 23, with sports, pizza, laser tag, a frosh BBQ, and a bonfire. The full schedule is on the Welcome Week page, and no sign-up is needed for the open campus events.',
    link: { href: '/campuses/sjsu/welcome-week', text: 'See the Welcome Week schedule' },
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'San José State University', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at SJSU',
    alternateName: ['Klesis SJSU', 'Klesis Christian Fellowship'],
    description:
      'A Christian club and campus fellowship for students at San José State University, part of Silicon Valley College Church. Open to all students.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis_sjsu/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'San José State University' },
    location: {
      '@type': 'Place',
      name: 'San José State University',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1 Washington Sq',
        addressLocality: 'San Jose',
        addressRegion: 'CA',
        postalCode: '95192',
        addressCountry: 'US',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#4corners`,
    name: '4Corners Christian Fellowship at SJSU',
    alternateName: ['4Corners SJSU', 'Four Corners SJSU'],
    description:
      'A Christian fellowship for international students at San José State University, part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/ismp_sjsu/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'San José State University' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Klesis SJSU | Christian Club & Bible Study at San José State"
  description="Klesis and 4Corners are Christian clubs at San José State University. Bible study, free food, and real friendships for SJSU students. Everyone is welcome."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <section class="hero-section" style="view-transition-name: campus-sjsu">
      <a href="/campuses" class="back-link">← Campuses</a>
      <h1 class="school-name">San José State <br/>University</h1>
      <p class="hero-tagline">Christian clubs, Bible study, and community for SJSU students</p>
    </section>

    <a href="/campuses/sjsu/welcome-week" class="welcome-week-banner">
      <span class="ww-banner-label">Welcome Week</span>
      <span class="ww-banner-dates">Aug 15 – 23</span>
      <span class="ww-banner-arrow" aria-hidden="true">→</span>
    </a>

    <section class="groups-section">
      <div class="group-col">
        <Image src={klesisSjsu} alt="Klesis Christian Fellowship logo, San José State University" class="group-logo" />
        <h2 class="group-label">Klesis Christian Fellowship · SJSU</h2>
        <p class="group-body">Klesis is a Christian club at San José State built for friendships, purpose, sports, nerf battles, investigating the Christian faith, and being there for one another. It is modeled after the Acts 2 church and open to every SJSU student, whatever you believe right now.</p>
        {CONNECT_GROUPS_LIVE ? (
          <a href="/campuses/sjsu/connect-groups" class="group-link">Connect Groups ↗</a>
        ) : (
          <a href="https://www.instagram.com/klesis_sjsu/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
        )}
      </div>
      <div class="col-divider" aria-hidden="true"></div>
      <div class="group-col">
        <Image src={fourCorners} alt="4Corners Christian Fellowship logo, San José State University" class="group-logo group-logo--large" />
        <h2 class="group-label">4Corners Christian Fellowship · SJSU</h2>
        <p class="group-body">4Corners is a fellowship for international students at SJSU. It is a place to find community, mentorship, explore the Christian faith, and feel at home in a new country. International and domestic students are both welcome.</p>
        <a href="https://www.instagram.com/ismp_sjsu/" target="_blank" rel="noopener noreferrer" class="group-link">Events ↗</a>
      </div>
    </section>

    <section class="facts-section">
      <h2 class="section-heading">Christian life at San José State</h2>
      <div class="facts-grid">
        <div class="fact">
          <p class="fact-label">Recognized student orgs</p>
          <p class="fact-body">Klesis Christian Fellowship and 4Corners Christian Fellowship are both officially recognized student organizations at San José State.</p>
        </div>
        <div class="fact">
          <p class="fact-label">Sundays together</p>
          <p class="fact-body">The whole church gathers Sundays at 12 PM at Horace Mann Elementary School, 55 N 7th St, a short walk from campus. <a href="/gather">See the Sunday gathering</a>.</p>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <h2 class="section-heading">Common questions from SJSU students</h2>
      <div class="faq-accordion">
        {faqs.map((f, i) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false" aria-controls={`sjsu-faq-${i + 1}`}>
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content" id={`sjsu-faq-${i + 1}`}>
              <p>
                {f.a}
                {f.link && <> <a href={f.link.href}>{f.link.text}</a>.</>}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
    border-bottom: 1px solid rgba(35, 32, 29, 0.08);
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #805E13;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #6B4D10; }

  .school-name {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #004A8A;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(35, 32, 29, 0.62);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .welcome-week-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: #E9C77E;
    color: #004A8A;
    text-decoration: none;
    padding: 3.5rem 2rem;
    font-family: 'Instrument Sans', sans-serif;
    transition: background 0.15s ease;
  }
  .welcome-week-banner:hover { background: #E0B85E; }

  .ww-banner-label {
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .ww-banner-dates {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 2rem;
  }

  .ww-banner-arrow {
    font-size: 1.6rem;
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .welcome-week-banner { padding: 2.5rem 1.25rem; gap: 0.8rem; }
    .ww-banner-label { font-size: 1.1rem; }
    .ww-banner-dates { font-size: 1.35rem; }
    .ww-banner-arrow { font-size: 1.2rem; }
  }

  .groups-section {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
  }

  .col-divider {
    background: rgba(35, 32, 29, 0.08);
    align-self: stretch;
  }

  .group-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 3rem;
    gap: 1.25rem;
  }

  .group-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.25rem;
    border-radius: 10px;
  }

  .group-logo--large {
    height: 78px;
    object-fit: contain;
  }

  .group-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #805E13;
  }

  .group-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.62);
    max-width: 36ch;
  }

  .group-link {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #004A8A;
    text-decoration: none;
    padding: 0.75rem 2.25rem;
    margin-top: 0.75rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .group-link:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  /* ── FACTS + FAQ ── */
  .section-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #004A8A;
    text-align: center;
    margin-bottom: 3rem;
  }

  .facts-section,
  .faq-section {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    max-width: 46rem;
    margin: 0 auto;
  }

  .fact-label {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #805E13;
    margin-bottom: 0.9rem;
  }

  .fact-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.75;
    color: rgba(35, 32, 29, 0.62);
  }

  .fact-body a {
    color: #004A8A;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(0, 74, 138, 0.35);
    transition: text-decoration-color 0.2s ease;
  }
  .fact-body a:hover { text-decoration-color: #004A8A; }

  .faq-accordion {
    max-width: 46rem;
    margin: 0 auto;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-item {
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 800;
    color: #23201D;
    transition: color 0.2s ease;
  }
  .accordion-trigger:hover { color: #004A8A; }

  .accordion-icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
    color: #004A8A;
    transition: transform 0.25s ease;
  }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-content p {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.6);
    padding-bottom: 1.5rem;
  }

  .accordion-content a {
    color: #004A8A;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(0, 74, 138, 0.35);
    transition: text-decoration-color 0.2s ease;
  }
  .accordion-content a:hover { text-decoration-color: #004A8A; }

  @media (max-width: 860px) {
    .facts-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  @media (max-width: 640px) {
    .groups-section {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1px auto;
    }
    .col-divider {
      width: 100%;
      height: 1px;
    }
    .group-col { padding: 3.5rem 2rem; }

    .facts-section,
    .faq-section { padding: 3.5rem 1.5rem; }
    .section-heading { margin-bottom: 2rem; }
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.parentElement!;
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      content.style.maxHeight = !isOpen ? content.scrollHeight + 'px' : '';
    });
  });
</script>
