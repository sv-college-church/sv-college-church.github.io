---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisUcsc from '../../assets/images/campuses/logos/klesis-ucsc.png';

const pageUrl = new URL('/campuses/ucsc', Astro.site).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'UC Santa Cruz', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at UC Santa Cruz',
    alternateName: 'Klesis UCSC',
    description: 'A Christian fellowship at UC Santa Cruz, open to all incoming and current UCSC students. Part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis.ucsc/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'UC Santa Cruz' },
    foundingDate: '2015',
  },
];
---

<BaseLayout
  title="Klesis UCSC | Christian Fellowship & Bible Study at UC Santa Cruz"
  description="Klesis is a Christian fellowship at UC Santa Cruz. Bible study and community, open to all UCSC students, Christian or not."
  structuredData={structuredData}
>
  <Nav />

  <main>

    <section class="hero-section" style="view-transition-name: campus-ucsc">
      <a href="/campuses" class="back-link">← Campuses</a>
      <Image src={klesisUcsc} alt="Klesis Christian Fellowship logo, UC Santa Cruz" class="hero-logo" />
      <p class="hero-fellowship">Klesis</p>
      <h1 class="school-name">UC Santa Cruz</h1>
      <p class="hero-tagline">A Christian fellowship and Bible study at UC Santa Cruz</p>
    </section>

    <section class="info-grid">
      <div class="info-col">
        <h2 class="info-label">Established</h2>
        <p class="info-value">2015</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">About</h2>
        <p class="about-value">Open to all incoming and current UCSC students, Christian or not.</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Events</h2>
        <a href="https://joinflyer.com/ucsc/klesis" target="_blank" rel="noopener noreferrer" class="events-btn">Flyer ↗</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #EAF5F4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #B99A3A;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #93792E; }

  .school-name {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #2C4F72;
  }

  .hero-logo {
    height: 90px;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .hero-fellowship {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(10, 10, 10, 0.5);
    margin-bottom: 1.25rem;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(10, 10, 10, 0.55);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .about-value {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(10, 10, 10, 0.62);
  }

  .info-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 1rem 3rem 6rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .info-label {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #2C4F72;
    margin: 0;
  }

  .info-value {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    color: rgba(10, 10, 10, 0.75);
  }

  .events-btn {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #2C4F72;
    text-decoration: none;
    padding: 0.85rem 2.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .events-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      padding: 0 2rem 4rem;
    }
    .info-col {
      padding: 2rem 1rem;
    }
  }
</style>
