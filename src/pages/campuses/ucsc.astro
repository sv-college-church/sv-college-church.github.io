  /* Same card look as #polaroid-stack's .polaroid-card on the homepage:
     white frame, thick bottom edge for the classic polaroid caption
     strip (left blank here), layered soft shadow. Frame thickness matches
     that card's proportions (14px/56px sides/bottom on its ~580px card)
     scaled down for this card's smaller 240px size. --dx/--dy/--rot come
     from the inline style on each card (see the markup) — one fixed
     scatter position per card rather than re-randomized on every hover,
     so each group's photo always lands the same way. Centered via
     top/left:50% + the -50%/-50% half of the transform, with the
     scatter offset and (for the hidden state) the drop-in lift stacked
     on top of that centering in the same transform. */
  .group-preview-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 240px;
    height: 240px;
    background: #ffffff;
    border-radius: 9px;
    padding: 7px 7px 24px;
    box-sizing: border-box;
    box-shadow:
      0 2px 6px rgba(35, 32, 29, 0.09),
      0 8px 20px rgba(35, 32, 29, 0.14),
      0 20px 40px rgba(35, 32, 29, 0.1);
    opacity: 0;
    /* Hidden state starts 70px above its landing spot, same drop-in
       direction as the homepage stack. The bounce (cubic-bezier with a
       >1 middle value) is that stack's exact easing too. */
    transform: translate(-50%, -50%) translate(var(--dx), calc(var(--dy) - 70px)) rotate(var(--rot));
    transition: transform 0.5s cubic-bezier(0.34, 1.3, 0.64, 1), opacity 0.3s ease;
  }
  .group-preview-card.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) rotate(var(--rot));
  }

  .group-preview-card-inner {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
  }
  .group-preview-card-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

