---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisUcsc from '../../assets/images/campuses/logos/klesis-ucsc.png';
import friendsgiving from '../../assets/images/campuses/ucsc/friendsgiving.jpg';
import sledding from '../../assets/images/campuses/ucsc/sledding.jpg';
import winterGroup from '../../assets/images/campuses/ucsc/winter-conference-group.jpg';
import winterWindowChat from '../../assets/images/campuses/ucsc/winter-conference-window-chat.jpg';
import winterFriendGroup from '../../assets/images/campuses/ucsc/winter-conference-friend-group.jpg';
import friendsgivingPlates from '../../assets/images/campuses/ucsc/friendsgiving-plates.jpg';
import friendsgivingLaughing from '../../assets/images/campuses/ucsc/friendsgiving-laughing.jpg';
import friendsgivingCardGame from '../../assets/images/campuses/ucsc/friendsgiving-card-game.jpg';
import connectGroupBibleReading from '../../assets/images/campuses/ucsc/connect-group-bible-reading.jpg';
import connectGroupCharcuterieBoard from '../../assets/images/campuses/ucsc/connect-group-charcuterie-board.jpg';
import connectGroupCharcuterieFriends from '../../assets/images/campuses/ucsc/connect-group-charcuterie-friends.jpg';
import connectGroupProteinProverbs from '../../assets/images/campuses/ucsc/connect-group-protein-proverbs.jpg';

const pageUrl = new URL('/campuses/ucsc', Astro.site).href;
const flyerUrl = 'https://joinflyer.com/ucsc/klesis';

// From Klesis Santa Cruz's own Flickr (flickr.com/photos/pursuitcollegechurch).
// The original 3 were used with the campus team's direction on which photos to
// feature; the 5 added after that (window chat, friend-group hug, and the 3
// Friendsgiving shots below) were picked from the same two events'
// already-approved albums (2024-01-20 NorCal Winter Conference,
// 2023-11-17 Friendsgiving) by browsing for more landscape, on-brand shots —
// not separately confirmed with the campus team, so swap any of them out if
// they'd rather feature different moments. Flickr caps anonymous downloads at
// 1024px on the long edge for this (free-tier) account — confirmed by
// requesting the 1600/2048/original variants directly and getting HTTP 410 for
// all three — so 1024px is the actual ceiling available here, not a resizing
// choice made in this codebase.
// Landscape only — a portrait shot (the snowball fight) let in a lot of
// letterboxing on wide desktop screens, so it's been dropped rather than
// kept behind the fade.
const carouselPhotos = [
  { src: friendsgiving, alt: 'Klesis students gathered around the kitchen at a Friendsgiving dinner' },
  { src: sledding, alt: 'Klesis students sledding at the NorCal Winter Conference' },
  { src: winterGroup, alt: 'Klesis Santa Cruz group photo at the NorCal Winter Conference' },
  { src: winterWindowChat, alt: 'Klesis students chatting by a window overlooking the snow at the NorCal Winter Conference' },
  { src: winterFriendGroup, alt: 'Klesis students posing together in the snow at the NorCal Winter Conference' },
  { src: friendsgivingPlates, alt: 'Klesis students smiling with plates of food at Friendsgiving' },
  { src: friendsgivingLaughing, alt: 'Klesis students laughing together at Friendsgiving' },
  { src: friendsgivingCardGame, alt: 'Klesis students laughing over a card game at Friendsgiving' },
];

// previewPhotos are real photos of each group, submitted by the campus team.
// Most groups get one photo; a group can list more than one (Charcuterie
// Chats gets two — a board shot and a group shot) and all of that group's
// photos drop in together when its row is hovered.
const groups = [
  {
    name: 'Bible Reading Project',
    leads: 'Robbie & Alyssa',
    time: 'Thursdays, 7 – 8 PM',
    tagline: 'Meet weekly to read the Bible together! No experience or religious background necessary.',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/frosh-starter-pack---week-1-sep-23-2026',
    previewPhotos: [connectGroupBibleReading],
  },
  {
    name: 'Charcuterie Chats',
    leads: 'Kerri & Jeanine',
    time: 'Thursdays, 7 – 8 PM',
    tagline: 'Make new friends and have meaningful conversations over themed Bible passages and charcuterie boards!',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/charcuterie-chats---week-1-sep-24-2026',
    previewPhotos: [connectGroupCharcuterieBoard, connectGroupCharcuterieFriends],
  },
  {
    name: 'Protein & Proverbs',
    leads: 'Joey & John',
    time: 'Thursdays, 7 – 8:30 PM',
    // *marinate* renders as emphasis — see withEmphasis() below.
    tagline: 'Join us for some good food and good thoughts as we *marinate* in the wisdom of the book of Proverbs!',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/protein-proverbs---week-1-sep-24-2026',
    previewPhotos: [connectGroupProteinProverbs],
  },
];

// Turns *word* into <em>word</em> for taglines that want a single
// emphasized word/phrase without pulling in a Markdown renderer for one
// use. Escape any raw HTML-sensitive characters first since this result
// gets rendered with set:html.
function withEmphasis(text: string) {
  const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\*(.+?)\*/g, '<em>$1</em>');
}

// Flattened one entry per photo (not per group) so a group with multiple
// previewPhotos gets multiple stacked cards. `group` is the owning group's
// index — hovering row i reveals every card whose group is <= i, so a
// multi-photo group's cards all drop in together. Fixed --dx/--dy/--rot
// scatter per card (one set per flattened photo, not per group). The two
// Charcuterie Chats cards sit diagonally opposite each other (board
// upper-left, friends lower-right), overlapping enough near that shared
// corner to read as one connected pile rather than two disjoint photos.
const previewCards = groups.flatMap((g, i) => g.previewPhotos.map((photo) => ({ photo, group: i })));
const previewOffsets = [
  { dx: -8, dy: 8, rot: -4 },
  { dx: -72, dy: -66, rot: -6 },
  { dx: 72, dy: 66, rot: 5 },
  { dx: 8, dy: -8, rot: 4 },
];
// object-position per card — everything defaults to a centered crop.
// Bible Reading Project's photo stays anchored left; the charcuterie
// board photo is anchored right, since the actual spread of food sits on
// the right two-thirds of that shot and a centered crop lost too much of
// it to the counter clutter on the left.
const previewFocus = ['left center', 'right center', 'center', 'center'];

// Location and time are confirmed for both dates. No ride details exist
// yet, so there's nothing to note about them on the page for now.
const serviceDates = [
  {
    date: 'Sun, Sep 20',
    isoDate: '2026-09-20',
    time: '12 PM',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/klesis-sunday-gathering-sep-20-2026',
  },
  {
    date: 'Sun, Sep 27',
    isoDate: '2026-09-27',
    time: '12 PM',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/klesis-sunday-gathering-sep-27-2026',
  },
];
const serviceLocation = 'Baskin Engineering Hall';
const serviceLocationConfirmed = true;

const faqs = [
  {
    q: 'Is there a Christian fellowship at UC Santa Cruz?',
    a: 'Yes. Klesis is a Christian fellowship at UC Santa Cruz, part of Silicon Valley College Church, open to all incoming and current UCSC students.',
  },
  {
    q: 'Where can I find a Bible study near UCSC?',
    a: 'Klesis gathers for Bible study and community on and around the UCSC campus. Current Connect Groups and meeting times are listed above.',
  },
  {
    q: 'Do I have to be a Christian to come?',
    a: 'No. Klesis is open to every UCSC student, Christian or not.',
  },
  {
    q: 'What should I expect at Sunday Gathering?',
    a: 'A relaxed, welcoming service, worship music, a short message from Scripture, and time to meet people afterward.',
  },
  {
    q: "What's the dress code?",
    a: 'Come as you are. Jeans and a t-shirt is completely normal.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'UC Santa Cruz', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at UC Santa Cruz',
    alternateName: 'Klesis UCSC',
    description: 'A Christian fellowship at UC Santa Cruz, open to all incoming and current UCSC students. Part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis.ucsc/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'UC Santa Cruz' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  // Event structured data for Sunday Gathering — only added once
  // serviceLocationConfirmed is true, so nothing tentative gets published
  // to search results.
  ...(serviceLocationConfirmed
    ? serviceDates.map((s) => ({
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: 'Klesis Sunday Gathering',
        startDate: `${s.isoDate}T12:00:00-07:00`,
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        eventStatus: 'https://schema.org/EventScheduled',
        location: {
          '@type': 'Place',
          name: serviceLocation,
          address: { '@type': 'PostalAddress', addressLocality: 'Santa Cruz', addressRegion: 'CA', addressCountry: 'US' },
        },
        organizer: { '@id': `${pageUrl}#klesis` },
        url: s.signupUrl,
      }))
    : []),
];
---

<BaseLayout
  title="Klesis UCSC | Christian Fellowship & Bible Study at UC Santa Cruz"
  description="Klesis is a Christian fellowship at UC Santa Cruz. Connect Groups, Sunday Gathering, and Welcome Week, open to all UCSC students, Christian or not."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <!-- ── WELCOME WEEK BANNER ── -->
    <!-- Now the very first thing on the page, so it carries its own
         nav-clearance padding instead of the carousel below it. -->
    <a href={flyerUrl} target="_blank" rel="noopener noreferrer" class="ww-banner">
      <span class="ww-banner-eyebrow">Welcome Week</span>
      <span class="ww-banner-copy">
        <!-- Shorter phrasing swaps in below the mobile breakpoint — the
             full "Welcome, Class of 2030!" wording wraps onto 2 lines on
             narrow phones, and a wrapped banner reads worse than a
             slightly terser one. -->
        <span class="ww-banner-copy-full">Welcome, Class of 2030! Check out our Welcome Week events!</span>
        <span class="ww-banner-copy-short">Class of 2030: Check out our Welcome Week events!</span>
      </span>
      <span class="ww-banner-arrow">↗</span>
    </a>

    <!-- ── CAROUSEL / HERO ── -->
    <!-- A slideshow, not a marquee: one photo at a time, holds 5s, crossfades.
         object-fit:contain (not cover) so no photo gets cropped. The source
         photos cap out at 1024px (Flickr's free-tier download limit), so
         .carousel-frame caps how large they're ever displayed — stretching
         them to fill a wide desktop viewport is what was causing the blur.
         The empty space that leaves fades to black via .carousel-vignette
         rather than showing bare bars; .carousel-slides stays full-bleed
         black behind it so there's no visible seam on ultra-wide screens. -->
    <section class="carousel" aria-label="Photos from Klesis Santa Cruz" style="view-transition-name: campus-ucsc">
      <div class="carousel-slides">
        <div class="carousel-frame">
          {carouselPhotos.map((p, i) => (
            <Image src={p.src} alt={p.alt} class="carousel-slide" data-slide={i} />
          ))}
          <div class="carousel-vignette" aria-hidden="true"></div>
          <!-- Mobile-only (see .carousel-dots below) — a small signal
               that this is a rotating set of photos, not a single static
               background image, since nothing else on screen hints at
               that once it's cropped full-bleed behind the identity
               content. -->
          <div class="carousel-dots" aria-hidden="true">
            {carouselPhotos.map((_, i) => (
              <span class="carousel-dot" data-dot={i}></span>
            ))}
          </div>
        </div>
        <!-- Full-bleed, spans the whole slides track (photo + the black
             letterboxed sides), not just the framed photo. -->
        <div class="carousel-color-wash" aria-hidden="true"></div>
      </div>

      <div class="carousel-overlay">
        <a href="/campuses" class="back-link">← Campuses</a>

        <!-- Every other /campuses page has an h1 with its school name
             (see stanford.astro's "Stanford University", etc.) — this page
             lost that in the redesign, since the wordmark + subtitle were
             marked up as a span/p with no heading at all. Wrapping both in
             an h1 fixes that (axe's page-has-heading-one) without touching
             their own layout — .hero-heading below just replicates the
             column stacking .carousel-overlay already gave them as direct
             flex children. -->
        <h1 class="hero-heading">
          <div class="hero-lockup">
            <Image src={klesisUcsc} alt="Klesis Christian Fellowship logo, UC Santa Cruz" class="hero-logo" />
            <span class="hero-wordmark">klesis</span>
          </div>
          <p class="hero-subtitle">at UC Santa Cruz</p>
        </h1>
        <p class="hero-tagline">A Christian fellowship and Bible study at UC Santa Cruz</p>

        <div class="hero-ctas">
          <a href="#connect-groups" class="hero-cta">Connect Groups</a>
          <a href="#sunday-service" class="hero-cta">Sunday Gathering</a>
        </div>
      </div>
    </section>

    <!-- ── CONNECT GROUPS ── -->
    <section id="connect-groups" class="groups-section">
      <h2 class="section-heading">Connect Groups</h2>
      <p class="section-sub">Small groups of students, meeting weekly to grow in faith and friendship.</p>

      <div class="groups-layout">
        <!-- Desktop-only (see the max-width:768px override below) — hover
             doesn't exist on touch, and a tap-to-reveal fallback would
             need its own stuck-state handling like .hero-cta needed
             earlier on this page, so this is a pointer-only enhancement
             rather than something everyone gets a flattened version of.
             Square polaroid cards, dropping in one on top of the next —
             same card look and drop-in motion as #polaroid-stack on the
             homepage, just driven by which row is hovered instead of a
             timed reveal on load. Hovering row i shows every card whose
             group is 0..i (a group with multiple preview photos drops
             them in together); each card's own small offset/rotation is
             fixed (not re-randomized per hover) so it lands the same way
             every time. -->
        <div class="group-preview" aria-hidden="true">
          {previewCards.map((card, i) => (
            <div class="group-preview-card" class:list={[{ 'is-visible': card.group === 0 }]} data-group={card.group} style={`--dx: ${previewOffsets[i].dx}px; --dy: ${previewOffsets[i].dy}px; --rot: ${previewOffsets[i].rot}deg; z-index: ${i + 1};`}>
              <div class="group-preview-card-inner">
                <Image src={card.photo} alt="" style={`object-position: ${previewFocus[i]};`} />
              </div>
            </div>
          ))}
        </div>

        <ul class="groups-list">
          {groups.map((g, i) => (
            <li class="group-row" data-group={i}>
              <div class="group-info">
                <p class="group-name">{g.name}</p>
                <p class="group-meta">Mentors: {g.leads} · {g.time}</p>
                {g.tagline && <p class="group-tagline" set:html={withEmphasis(g.tagline)} />}
              </div>
              <a href={g.signupUrl} target="_blank" rel="noopener noreferrer" class="group-signup-btn">Sign Up ↗</a>
            </li>
          ))}
        </ul>
      </div>

      <p class="section-note">See all groups and events on <a href={flyerUrl} target="_blank" rel="noopener noreferrer">Flyer ↗</a></p>
    </section>

    <!-- ── SUNDAY WORSHIP SERVICE ── -->
    <section id="sunday-service" class="service-section">
      <h2 class="section-heading">Sunday Gathering</h2>
      <p class="section-sub">Join us for the first two Sundays of the school year.</p>

      <ul class="service-list">
        {serviceDates.map((s) => (
          <li class="service-row">
            <div class="service-info">
              <span class="service-date">{s.date}</span>
              <span class="service-time">{s.time}</span>
              <span class="service-loc">
                {serviceLocation}
                {!serviceLocationConfirmed && <span class="service-tbc">(location TBC)</span>}
              </span>
            </div>
            <a href={s.signupUrl} target="_blank" rel="noopener noreferrer" class="service-signup-btn">Sign Up ↗</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── FAQ ── -->
    <section class="faq-section">
      <h2 class="section-heading">Common questions</h2>
      <div class="faq-accordion">
        {faqs.map((f, i) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false" aria-controls={`faq-panel-${i}`}>
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <!-- aria-hidden mirrors aria-expanded on the trigger — the
                 max-height/overflow collapse only hides this visually, so
                 without it a screen reader's virtual cursor could still
                 read a closed answer sighted users can't see. -->
            <div class="accordion-content" id={`faq-panel-${i}`} aria-hidden="true">
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  /* ── WELCOME WEEK BANNER ── */
  /* Now the very first thing on the page — carries its own nav-clearance
     top padding. main has no side padding of its own, so a plain
     block-level width fills it edge to edge. Still the only element on
     the page carrying the pastel gradient. */
  .ww-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    width: 100%;
    /* Nav is fixed at 8rem tall on desktop (5rem on mobile) and overlays
       whatever's behind it, so top padding = nav height + the same 2.25rem
       breathing room used on the bottom — equal padding is what actually
       centers the text visually below the nav, a flat 8.5rem top made the
       text sit hard against the nav with dead space below it instead. */
    padding: calc(8rem + 2.25rem) 2rem 2.25rem;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .ww-banner:hover {
    filter: brightness(1.03);
  }

  /* The browser's default focus ring was effectively invisible here —
     this banner is a full-bleed, near-viewport-width link, and its
     default outline drew at the very edge of that huge box where it's
     easy to miss (confirmed by tabbing to it: no perceptible change,
     unlike the hero-cta buttons' own :focus-visible). Charcoal was
     already verified elsewhere on this page to clear AA contrast against
     both ends of this same gradient, and outline-offset is negative so
     the ring stays inside the banner's own box instead of getting
     clipped by the viewport at y=0. */
  .ww-banner:focus-visible {
    outline: 3px solid #23201D;
    outline-offset: -4px;
  }

  .ww-banner-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #004A8A;
    flex-shrink: 0;
  }

  .ww-banner-copy {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    color: #23201D;
    text-align: center;
  }

  .ww-banner-copy-short {
    display: none;
  }

  .ww-banner-arrow {
    font-size: 1.1rem;
    font-weight: 700;
    color: #004A8A;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .ww-banner { padding: calc(5rem + 1.75rem) 1.5rem 1.75rem; }
    .ww-banner-copy-full { display: none; }
    .ww-banner-copy-short {
      display: inline;
      /* The shorter wording alone isn't enough to keep this on one line
         down at typical phone widths (~375-430px) at the parent's
         font-size — this scales down with viewport width, floored so it
         never gets too small to read, capped at the parent's own size so
         it doesn't grow past it near the 768px edge of this query. */
      font-size: clamp(0.8rem, 3.3vw, 1.2rem);
    }
  }

  /* ── CAROUSEL / HERO ── */
  /* Full-bleed and full-screen-height — ignores main's padding and runs
     edge to edge. Sits right after the banner now, so no nav-clearance
     padding of its own is needed. The Klesis / UC Santa Cruz identity
     overlays on top of the slides via .carousel-overlay, at every
     breakpoint — see the <768px override below for how mobile fills the
     screen with a cropped photo instead of the letterboxed one here. */
  .carousel {
    position: relative;
    width: 100%;
  }

  .carousel-slides {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
  }

  /* Sized to the photos' own 1024x683 ratio (all three share it) instead
     of a forced 100vh box — that mismatch was what left black letterboxing
     above and below the photo. Height now just follows the image, and a
     smaller max-width keeps the 1024px source from upscaling into visible
     softness. Still centered within the full-bleed black slides track for
     ultra-wide screens.
     Below the mobile breakpoint this switches to a fixed full-screen
     height instead — see the <768px override further down. */
  .carousel-frame {
    position: relative;
    width: 100%;
    max-width: 950px;
    aspect-ratio: 1024 / 683;
    margin: 0 auto;
    border-radius: 6px;
    overflow: hidden;
  }

  .carousel :global(.carousel-slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.2s ease;
    /* Slight warm, faded grade for a more vintage-photo feel. */
    filter: sepia(0.12) saturate(0.85) contrast(1.05);
  }

  .carousel :global(.carousel-slide.is-active) {
    opacity: 1;
  }

  /* Experimental: ties the hero back to the banner's pastel gradient above
     it. A plain translucent layer (not blended) so it actually reads as a
     color cast — mix-blend-mode: overlay only nudges contrast/saturation
     and was nearly invisible on these fairly desaturated forest/kitchen
     photos. Spans the full slides track (photo + letterboxed sides), not
     just the framed photo. Painted on top of .carousel-vignette (below),
     so the vignette is tuned dark enough to still clear text-contrast
     even with this light wash layered over it. */
  .carousel-color-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
    opacity: 0.22;
  }

  /* Radial fade, darkening toward the edges and fading all the way to
     solid black at the true edge — that last stop has to be fully
     opaque, not just dark, or the photo's edge meets the surrounding
     black .carousel-slides background as a visible seam instead of a
     smooth fade.
     The center alpha (0.65) isn't just aesthetic — it's load-bearing for
     WCAG AA text contrast: the overlaid white text sits roughly here, and
     against a worst-case bright photo (the snow shots) with the pastel
     wash layered on top, anything much lighter than this drops white text
     below the 4.5:1 minimum. Verified against both the brightest (snow)
     and mid-tone photos with the wash's alpha factored in. */
  .carousel-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 75% 75% at center, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.8) 50%, #000 100%);
  }

  /* Hidden by default — the desktop hero overlay already makes it obvious
     there's more than one photo (captions/CTAs sit right on top of it,
     it's clearly "a moment"). Shown only at the mobile breakpoint below,
     where the photo is a smaller, lower-key band and easy to mistake for
     a single static image. */
  .carousel-dots {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    z-index: 2;
    justify-content: center;
    gap: 0.4rem;
  }
