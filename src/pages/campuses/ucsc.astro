---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisUcsc from '../../assets/images/campuses/logos/klesis-ucsc.png';
import friendsgiving from '../../assets/images/campuses/ucsc/friendsgiving.jpg';
import sledding from '../../assets/images/campuses/ucsc/sledding.jpg';
import winterGroup from '../../assets/images/campuses/ucsc/winter-conference-group.jpg';

const pageUrl = new URL('/campuses/ucsc', Astro.site).href;
const flyerUrl = 'https://joinflyer.com/ucsc/klesis';

// From Klesis Santa Cruz's own Flickr (flickr.com/photos/pursuitcollegechurch),
// used with the campus team's direction on which photos to feature. Flickr caps
// anonymous downloads at 1024px on the long edge for this (free-tier) account —
// confirmed by requesting the 1600/2048/original variants directly and getting
// HTTP 410 for all three — so 1024px is the actual ceiling available here, not
// a resizing choice made in this codebase.
// Landscape only — a portrait shot (the snowball fight) let in a lot of
// letterboxing on wide desktop screens, so it's been dropped rather than
// kept behind the fade.
const carouselPhotos = [
  { src: friendsgiving, alt: 'Klesis students gathered around the kitchen at a Friendsgiving dinner' },
  { src: sledding, alt: 'Klesis students sledding at the NorCal Winter Conference' },
  { src: winterGroup, alt: 'Klesis Santa Cruz group photo at the NorCal Winter Conference' },
];

// Leads-only, no photos — matches the flat/minimal treatment requested for this page.
// Each group's signupUrl is its own Flyer event page (week 1), not the general Flyer profile.
const groups = [
  {
    name: 'Bible Reading Project',
    leads: 'Robbie & Alyssa',
    time: 'Thursdays, 7 – 8 PM',
    tagline: null,
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/frosh-starter-pack---week-1-sep-23-2026',
  },
  {
    name: 'Charcuterie Chats',
    leads: 'Kerri & Jeanine',
    time: 'Thursdays, 7 – 8 PM',
    tagline: 'Make new friends and have meaningful conversations over themed charcuterie boards!',
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/charcuterie-chats---week-1-sep-24-2026',
  },
  {
    name: 'Protein & Proverbs',
    leads: 'Joey & John',
    time: 'Thursdays, 7 – 8:30 PM',
    tagline: null,
    signupUrl: 'https://joinflyer.com/ucsc/klesis/event/protein-proverbs---week-1-sep-24-2026',
  },
];

// PLACEHOLDER — time is a working estimate, location and rides are unconfirmed.
// Update once Sunday Gathering details are locked in.
const serviceDates = ['Sun, Sep 20', 'Sun, Sep 27'];
const serviceTime = '3:30 PM';
const serviceLocation = 'Baskin Engineering Hall';
const serviceLocationConfirmed = false;

const faqs = [
  {
    q: 'Is there a Christian fellowship at UC Santa Cruz?',
    a: 'Yes. Klesis is a Christian fellowship at UC Santa Cruz, part of Silicon Valley College Church, open to all incoming and current UCSC students.',
  },
  {
    q: 'Where can I find a Bible study near UCSC?',
    a: 'Klesis gathers for Bible study and community on and around the UCSC campus. Current Connect Groups and meeting times are listed above.',
  },
  {
    q: 'Do I have to be a Christian to come?',
    a: 'No. Klesis is open to every UCSC student, Christian or not.',
  },
  {
    q: 'What should I expect at Sunday Gathering?',
    a: 'A relaxed, welcoming service, worship music, a short message from Scripture, and time to meet people afterward.',
  },
  {
    q: "What's the dress code?",
    a: 'Come as you are. Jeans and a t-shirt is completely normal.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'UC Santa Cruz', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at UC Santa Cruz',
    alternateName: 'Klesis UCSC',
    description: 'A Christian fellowship at UC Santa Cruz, open to all incoming and current UCSC students. Part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis.ucsc/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'UC Santa Cruz' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  // No Event structured data for Sunday Gathering yet — location isn't
  // confirmed, and publishing tentative facts to search results risks going
  // stale. Add once serviceLocationConfirmed is true.
];
---

<BaseLayout
  title="Klesis UCSC | Christian Fellowship & Bible Study at UC Santa Cruz"
  description="Klesis is a Christian fellowship at UC Santa Cruz. Connect Groups, Sunday Gathering, and Welcome Week, open to all UCSC students, Christian or not."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <!-- ── WELCOME WEEK BANNER ── -->
    <!-- Now the very first thing on the page, so it carries its own
         nav-clearance padding instead of the carousel below it. -->
    <a href={flyerUrl} target="_blank" rel="noopener noreferrer" class="ww-banner">
      <span class="ww-banner-eyebrow">Welcome Week</span>
      <span class="ww-banner-copy">Welcome, Class of 2030! Check out our Welcome Week events!</span>
      <span class="ww-banner-arrow">↗</span>
    </a>

    <!-- ── CAROUSEL / HERO ── -->
    <!-- A slideshow, not a marquee: one photo at a time, holds 5s, crossfades.
         object-fit:contain (not cover) so no photo gets cropped. The source
         photos cap out at 1024px (Flickr's free-tier download limit), so
         .carousel-frame caps how large they're ever displayed — stretching
         them to fill a wide desktop viewport is what was causing the blur.
         The empty space that leaves fades to black via .carousel-vignette
         rather than showing bare bars; .carousel-slides stays full-bleed
         black behind it so there's no visible seam on ultra-wide screens. -->
    <section class="carousel" aria-label="Photos from Klesis Santa Cruz" style="view-transition-name: campus-ucsc">
      <div class="carousel-slides">
        <div class="carousel-frame">
          {carouselPhotos.map((p, i) => (
            <Image src={p.src} alt={p.alt} class="carousel-slide" data-slide={i} />
          ))}
          <div class="carousel-vignette" aria-hidden="true"></div>
        </div>
        <!-- Full-bleed, spans the whole slides track (photo + the black
             letterboxed sides), not just the framed photo. -->
        <div class="carousel-color-wash" aria-hidden="true"></div>
      </div>

      <div class="carousel-overlay">
        <a href="/campuses" class="back-link">← Campuses</a>

        <div class="hero-lockup">
          <Image src={klesisUcsc} alt="Klesis Christian Fellowship logo, UC Santa Cruz" class="hero-logo" />
          <span class="hero-wordmark">klesis</span>
        </div>
        <p class="hero-subtitle">at UC Santa Cruz</p>
        <p class="hero-tagline">A Christian fellowship and Bible study at UC Santa Cruz</p>

        <div class="hero-ctas">
          <a href="#connect-groups" class="hero-cta">Connect Groups</a>
          <a href="#sunday-service" class="hero-cta">Sunday Gathering</a>
        </div>
      </div>
    </section>

    <!-- ── CONNECT GROUPS ── -->
    <section id="connect-groups" class="groups-section">
      <h2 class="section-heading">Connect Groups</h2>
      <p class="section-sub">Small groups of students, meeting weekly to grow in faith and friendship.</p>

      <ul class="groups-list">
        {groups.map((g) => (
          <li class="group-row">
            <div class="group-info">
              <p class="group-name">{g.name}</p>
              <p class="group-meta">{g.leads} · {g.time}</p>
              {g.tagline && <p class="group-tagline">{g.tagline}</p>}
            </div>
            <a href={g.signupUrl} target="_blank" rel="noopener noreferrer" class="group-signup-btn">Sign Up ↗</a>
          </li>
        ))}
      </ul>

      <p class="section-note">See all groups and events on <a href={flyerUrl} target="_blank" rel="noopener noreferrer">Flyer ↗</a></p>
    </section>

    <!-- ── SUNDAY WORSHIP SERVICE ── -->
    <section id="sunday-service" class="service-section">
      <h2 class="section-heading">Sunday Gathering</h2>
      <p class="section-sub">Join us for the first two Sundays of the school year.</p>

      <ul class="service-list">
        {serviceDates.map((date) => (
          <li class="service-row">
            <span class="service-date">{date}</span>
            <span class="service-time">{serviceTime}</span>
            <span class="service-loc">
              {serviceLocation}
              {!serviceLocationConfirmed && <span class="service-tbc">(location TBC)</span>}
            </span>
          </li>
        ))}
      </ul>
      <p class="service-note">Ride details coming soon, check back or follow <a href="https://www.instagram.com/klesis.ucsc/" target="_blank" rel="noopener noreferrer">@klesis.ucsc</a> for updates.</p>
    </section>

    <!-- ── FAQ ── -->
    <section class="faq-section">
      <h2 class="section-heading">Common questions from UCSC students</h2>
      <div class="faq-accordion">
        {faqs.map((f) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false">
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  /* ── WELCOME WEEK BANNER ── */
  /* Now the very first thing on the page — carries its own nav-clearance
     top padding. main has no side padding of its own, so a plain
     block-level width fills it edge to edge. Still the only element on
     the page carrying the pastel gradient. */
  .ww-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    width: 100%;
    /* Nav is fixed at 8rem tall on desktop (5rem on mobile) and overlays
       whatever's behind it, so top padding = nav height + the same 2.25rem
       breathing room used on the bottom — equal padding is what actually
       centers the text visually below the nav, a flat 8.5rem top made the
       text sit hard against the nav with dead space below it instead. */
    padding: calc(8rem + 2.25rem) 2rem 2.25rem;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .ww-banner:hover {
    filter: brightness(1.03);
  }

  .ww-banner-eyebrow {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #004A8A;
    flex-shrink: 0;
  }

  .ww-banner-copy {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    color: #23201D;
    text-align: center;
  }

  .ww-banner-arrow {
    font-size: 1.1rem;
    font-weight: 700;
    color: #004A8A;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .ww-banner { padding: calc(5rem + 1.75rem) 1.5rem 1.75rem; }
  }

  /* ── CAROUSEL / HERO ── */
  /* Full-bleed and full-screen-height — ignores main's padding and runs
     edge to edge. Sits right after the banner now, so no nav-clearance
     padding of its own is needed. The Klesis / UC Santa Cruz identity
     overlays on top of the slides via .carousel-overlay. */
  .carousel {
    position: relative;
    width: 100%;
  }

  .carousel-slides {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
  }

  /* Sized to the photos' own 1024x683 ratio (all three share it) instead
     of a forced 100vh box — that mismatch was what left black letterboxing
     above and below the photo. Height now just follows the image, and a
     smaller max-width keeps the 1024px source from upscaling into visible
     softness. Still centered within the full-bleed black slides track for
     ultra-wide screens. */
  .carousel-frame {
    position: relative;
    width: 100%;
    max-width: 950px;
    aspect-ratio: 1024 / 683;
    margin: 0 auto;
    border-radius: 6px;
    overflow: hidden;
  }

  .carousel :global(.carousel-slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.2s ease;
    /* Slight warm, faded grade for a more vintage-photo feel. */
    filter: sepia(0.12) saturate(0.85) contrast(1.05);
  }

  .carousel :global(.carousel-slide.is-active) {
    opacity: 1;
  }

  /* Experimental: ties the hero back to the banner's pastel gradient above
     it. A plain translucent layer (not blended) so it actually reads as a
     color cast — mix-blend-mode: overlay only nudges contrast/saturation
     and was nearly invisible on these fairly desaturated forest/kitchen
     photos. Spans the full slides track (photo + letterboxed sides), not
     just the framed photo. Painted on top of .carousel-vignette (below),
     so the vignette is tuned dark enough to still clear text-contrast
     even with this light wash layered over it. */
  .carousel-color-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
    opacity: 0.22;
  }

  /* Radial fade, darkening toward the edges and fading all the way to
     solid black at the true edge — that last stop has to be fully
     opaque, not just dark, or the photo's edge meets the surrounding
     black .carousel-slides background as a visible seam instead of a
     smooth fade.
     The center alpha (0.65) isn't just aesthetic — it's load-bearing for
     WCAG AA text contrast: the overlaid white text sits roughly here, and
     against a worst-case bright photo (the snow shots) with the pastel
     wash layered on top, anything much lighter than this drops white text
     below the 4.5:1 minimum. Verified against both the brightest (snow)
     and mid-tone photos with the wash's alpha factored in. */
  .carousel-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 75% 75% at center, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.8) 50%, #000 100%);
  }

  .carousel-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }

  /* The frame's height now follows the photo's real aspect ratio instead
     of a forced 100vh, and on a narrow phone that's short — not enough
     room to overlay the whole identity block on the photo without it
     spilling into the banner above and the section below. Below this
     breakpoint the identity content drops into normal flow underneath
     the photo instead, on its own dark band. .back-link stays put — it's
     positioned off .carousel, not .carousel-overlay, so it still sits on
     the photo either way. */
  @media (max-width: 768px) {
    .carousel-overlay {
      position: static;
      z-index: auto;
      background: #17140f;
      padding: 2.5rem 1.5rem 3rem;
    }

    /* The strong vignette above is load-bearing for text contrast where
       the identity block is overlaid directly on the photo — that's no
       longer true here (it's in its own dark band below the photo), so
       there's no accessibility reason to darken the photo this heavily.
       Back to a lighter, more photo-forward vignette; .back-link is the
       only text still on the photo at this width and reads fine against
       it. */
    .carousel-vignette {
      background: radial-gradient(ellipse 75% 75% at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.55) 55%, #000 100%);
    }
  }

  .back-link {
    position: absolute;
    top: 2rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .back-link:hover { opacity: 0.75; }

  .hero-lockup {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-logo {
    height: 64px;
    width: auto;
    object-fit: contain;
    border-radius: 10px;
  }

  .hero-wordmark {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 800;
    text-transform: lowercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #ffffff;
  }

  .hero-subtitle {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: #ffffff;
    margin-top: 0.5rem;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: #ffffff;
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  /* Back to outline-only at rest — the opaque fill didn't land well as
     the default state. Hover fills with the same gradient + dark text
     as .ww-banner instead, so the brand pairing still shows up, just on
     interaction rather than always-on. */
  .hero-cta {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.3s ease;
  }
  .hero-cta:hover {
    color: #23201D;
    border-color: transparent;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
  }

  @media (max-width: 768px) {
    .back-link { top: 1.25rem; left: 1.25rem; }
    .hero-lockup { gap: 0.75rem; }
    .hero-logo { height: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel :global(.carousel-slide) { transition: none; }
  }

  /* ── SHARED SECTION STYLES ── */
  .section-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #2C4F72;
    text-align: center;
  }

  .section-sub {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.6);
    text-align: center;
    margin-top: 0.5rem;
  }

  /* ── CONNECT GROUPS ── */
  .groups-section {
    padding: 1rem 2rem 5rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .groups-section .section-heading { padding-top: 4rem; }

  .groups-list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    width: 100%;
    max-width: 42rem;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .group-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .group-info {
    min-width: 0;
  }

  .group-name {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 800;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: #23201D;
  }

  .group-meta {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: 0.95rem;
    color: rgba(35, 32, 29, 0.65);
    margin-top: 0.3rem;
  }

  .group-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.7);
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .group-signup-btn {
    flex-shrink: 0;
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #ffffff;
    background: #2C4F72;
    text-decoration: none;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .group-signup-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.25);
  }

  .section-note {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.7);
    text-align: center;
    margin-top: 2.5rem;
  }
  .section-note a {
    color: #2C4F72;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* ── SUNDAY WORSHIP SERVICE ── */
  .service-section {
    padding: 4rem 2rem 5rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .service-list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    width: 100%;
    max-width: 34rem;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .service-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.25rem 0.5rem;
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .service-date {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    color: #23201D;
  }

  .service-time {
    font-family: 'Bitter', Georgia, serif;
    font-weight: 350;
    font-style: italic;
    font-size: 1rem;
    color: #2C4F72;
  }

  .service-loc {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.65);
  }

  .service-tbc {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #A15C2A;
    margin-left: 0.4rem;
  }

  .service-note {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(35, 32, 29, 0.7);
    text-align: center;
    margin-top: 2rem;
    max-width: 34rem;
  }
  .service-note a {
    color: #2C4F72;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 768px) {
    .groups-section, .service-section { padding-left: 1.5rem; padding-right: 1.5rem; }
    .group-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .service-row { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .faq-section { padding: 3.5rem 1.5rem; }
    .section-heading { margin-bottom: 0; }
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .faq-section .section-heading { margin-bottom: 3rem; }

  .faq-accordion {
    max-width: 46rem;
    margin: 0 auto;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-item {
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 800;
    color: #23201D;
    transition: color 0.2s ease;
  }
  .accordion-trigger:hover { color: #2C4F72; }

  .accordion-icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
    color: #2C4F72;
    transition: transform 0.25s ease;
  }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-content p {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.6);
    padding-bottom: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.parentElement!;
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      content.style.maxHeight = !isOpen ? content.scrollHeight + 'px' : '';
    });
  });

  // Carousel: a slideshow, not a marquee — one photo at a time, holds 5s, crossfades.
  const slides = document.querySelectorAll<HTMLElement>('.carousel-slide');
  if (slides.length > 1) {
    slides[0].classList.add('is-active');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      let current = 0;
      setInterval(() => {
        slides[current].classList.remove('is-active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('is-active');
      }, 5000);
    }
  } else if (slides.length === 1) {
    slides[0].classList.add('is-active');
  }
</script>
