  /* Back to outline-only at rest — the opaque fill didn't land well as
     the default state. Hover fills with the same gradient + dark text
     as .ww-banner instead, so the brand pairing still shows up, just on
     interaction rather than always-on.
     The fill is a ::before layer that fades in via opacity, not a
     transition on `background` directly — browsers can't smoothly
     interpolate a solid/transparent background into a gradient, so
     animating `background` itself just snaps instantly regardless of
     the transition duration. Opacity animates properly, which is what
     actually makes this gradual. */
  .hero-cta {
    position: relative;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .hero-cta::before {
    content: '';
    position: absolute;
    /* Matches the border-width above (1.5px), not inset:0 — inset:0
       aligns this pseudo-element with .hero-cta's padding edge, i.e.
       just inside the border. Since the border itself turns transparent
       on hover/focus, a plain inset:0 fill left a 1.5px ring of
       see-through gap where the border used to be, making the button
       visibly shrink instead of just swapping outline for fill. Pulling
       the fill out by the same 1.5px makes it flush with the outline's
       own outer edge, so the footprint stays the same size. */
    inset: -1.5px;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(120deg, #A3D1EB 0%, #F7DEA8 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  /* Gated to devices that actually have a mouse-like pointer. Touch
     screens report a synthetic :hover on tap that can get stuck showing
     (no mouseout to clear it) until the user taps elsewhere — that's
     what was making the fill render as a half-applied, low-contrast
     mess on tablets/phones. Keyboard users get the same fill via
     :focus-visible below instead, since :hover alone would leave them
     with no equivalent feedback. */
  @media (hover: hover) and (pointer: fine) {
    .hero-cta:hover {
      color: #23201D;
      border-color: transparent;
    }
    .hero-cta:hover::before {
      opacity: 1;
    }
  }
  .hero-cta:focus-visible {
    color: #23201D;
    border-color: transparent;
    outline: 2px solid #23201D;
    outline-offset: 3px;
  }
  .hero-cta:focus-visible::before {
    opacity: 1;
  }

