---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisScu from '../../assets/images/campuses/logos/klesis-scu.png';

const pageUrl = new URL('/campuses/scu', Astro.site).href;

const faqs = [
  {
    q: 'Is there a Christian club at Santa Clara University?',
    a: 'Yes. Klesis is a recognized, non-denominational Christian club at Santa Clara University, part of Silicon Valley College Church.',
  },
  {
    q: 'Where can I find a Bible study near SCU?',
    a: 'Klesis meets weekly on campus for Bible study on Thursdays at 7:00 PM. Times and locations are posted on the Klesis Instagram.',
  },
  {
    q: 'Do I have to be a Christian to come?',
    a: "No. Klesis is open to any SCU student, whether you've been a Christian your whole life or you're checking it out for the first time.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Santa Clara University', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at Santa Clara University',
    alternateName: 'Klesis SCU',
    description: 'A recognized non-denominational Christian club at Santa Clara University, meeting weekly for Bible study and community. Part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis.scu/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Santa Clara University' },
    foundingDate: '2015',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Klesis SCU | Christian Club & Bible Study at Santa Clara University"
  description="Klesis is a recognized Christian club at Santa Clara University. Weekly Bible study, Thursdays at 7 PM. Open to all SCU students."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <section class="hero-section" style="view-transition-name: campus-scu">
      <a href="/campuses" class="back-link">← Campuses</a>
      <Image src={klesisScu} alt="Klesis Christian Fellowship logo, Santa Clara University" class="hero-logo" />
      <p class="hero-fellowship">Klesis</p>
      <h1 class="school-name">Santa Clara<br/>University</h1>
      <p class="hero-tagline">A Christian club and Bible study at Santa Clara University</p>
    </section>

    <section class="info-grid">
      <div class="info-col">
        <h2 class="info-label">Established</h2>
        <p class="info-value">2015</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Bible Study</h2>
        <p class="info-value-small">Thursdays<br/>7:00 PM</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Events</h2>
        <a href="https://www.instagram.com/klesis.scu/" target="_blank" rel="noopener noreferrer" class="events-btn">Instagram ↗</a>
      </div>
    </section>

    <section class="about-section">
      <h2 class="info-label">About</h2>
      <p class="about-body">Klesis is a recognized, non-denominational Christian club at Santa Clara University. Klesis is Greek for "divine invitation," and the group is a safe space to seek God, study the Bible, and find friendship, whether you've been a Christian your whole life or you're checking it out for the first time.</p>
    </section>

    <section class="faq-section">
      <h2 class="section-heading">Common questions from SCU students</h2>
      <div class="faq-accordion">
        {faqs.map((f) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false">
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #A32035;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #7A1828; }

  .hero-logo {
    height: 90px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.5rem;
    border-radius: 10px;
  }

  .hero-fellowship {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(35, 32, 29, 0.62);
    margin-bottom: 1.25rem;
  }

  .school-name {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #A32035;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(35, 32, 29, 0.62);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .info-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 1rem 3rem 3rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .info-label {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #A32035;
    margin: 0;
  }

  .info-value {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    color: rgba(35, 32, 29, 0.7);
  }

  .info-value-small {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    color: rgba(35, 32, 29, 0.7);
  }

  .about-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 4rem 3rem 7rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
    margin: 0 3rem;
  }

  .about-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.62);
    max-width: 62ch;
    margin: 0;
  }

  .events-btn {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #A32035;
    text-decoration: none;
    padding: 0.85rem 2.5rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .events-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      padding: 0 2rem 4rem;
    }
    .info-col {
      padding: 2rem 1rem;
    }
    .about-section {
      padding: 3rem 2rem 4rem;
      margin: 0 2rem;
    }
    .faq-section { padding: 3.5rem 1.5rem; }
    .section-heading { margin-bottom: 2rem; }
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .section-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #A32035;
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-accordion {
    max-width: 46rem;
    margin: 0 auto;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-item {
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 800;
    color: #23201D;
    transition: color 0.2s ease;
  }
  .accordion-trigger:hover { color: #A32035; }

  .accordion-icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
    color: #A32035;
    transition: transform 0.25s ease;
  }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-content p {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.6);
    padding-bottom: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.parentElement!;
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      content.style.maxHeight = !isOpen ? content.scrollHeight + 'px' : '';
    });
  });
</script>
