---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import klesisScu from '../../assets/images/campuses/logos/klesis-scu.png';

const pageUrl = new URL('/campuses/scu', Astro.site).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Santa Clara University', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#klesis`,
    name: 'Klesis Christian Fellowship at Santa Clara University',
    alternateName: 'Klesis SCU',
    description: 'A recognized non-denominational Christian club at Santa Clara University, meeting weekly for Bible study and community. Part of Silicon Valley College Church.',
    url: pageUrl,
    sameAs: ['https://www.instagram.com/klesis.scu/'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'Santa Clara University' },
    foundingDate: '2015',
  },
];
---

<BaseLayout
  title="Klesis SCU | Christian Club & Bible Study at Santa Clara University"
  description="Klesis is a recognized Christian club at Santa Clara University. Weekly Bible study, Thursdays at 7 PM. Open to all SCU students."
  structuredData={structuredData}
>
  <Nav />

  <main>

    <section class="hero-section" style="view-transition-name: campus-scu">
      <a href="/campuses" class="back-link">← Campuses</a>
      <Image src={klesisScu} alt="Klesis Christian Fellowship logo, Santa Clara University" class="hero-logo" />
      <p class="hero-fellowship">Klesis</p>
      <h1 class="school-name">Santa Clara<br/>University</h1>
      <p class="hero-tagline">A Christian club and Bible study at Santa Clara University</p>
    </section>

    <section class="info-grid">
      <div class="info-col">
        <h2 class="info-label">Established</h2>
        <p class="info-value">2015</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Bible Study</h2>
        <p class="info-value-small">Thursdays<br/>7:00 PM</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Events</h2>
        <a href="https://www.instagram.com/klesis.scu/" target="_blank" rel="noopener noreferrer" class="events-btn">Instagram ↗</a>
      </div>
    </section>

    <section class="about-section">
      <h2 class="info-label">About</h2>
      <p class="about-body">Klesis is a recognized, non-denominational Christian club at Santa Clara University. Klesis is Greek for "divine invitation," and the group is a safe space to seek God, study the Bible, and find friendship, whether you've been a Christian your whole life or you're checking it out for the first time.</p>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #7A0525 !important; }
  body { display: flex; flex-direction: column; min-height: 100svh; }

  header {
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  header::before {
    background: rgba(100, 4, 30, 0.97) !important;
  }
  header a { color: rgba(255,255,255,0.75) !important; }
  header a:hover { color: #ffffff !important; }
  .hamburger-bar { background-color: rgba(255,255,255,0.8) !important; }
  .logo-main, .logo-depth { filter: invert(1) brightness(1.1) !important; }

  #mobile-menu nav {
    background: #640420 !important;
    border-color: rgba(255,255,255,0.08) !important;
  }
  #mobile-menu a {
    color: rgba(255,255,255,0.75) !important;
    border-color: rgba(255,255,255,0.08) !important;
  }

  footer {
    background: #640420 !important;
    border-color: rgba(255,255,255,0.1) !important;
  }
  footer p { color: rgba(255,255,255,0.6) !important; }
  footer a { color: rgba(255,255,255,0.6) !important; }
  footer a:hover { color: rgba(255,255,255,0.85) !important; }
  footer .network-logo { filter: none !important; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #ffffff; }

  .hero-logo {
    height: 90px;
    width: auto;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }

  .hero-fellowship {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.25rem;
  }

  .school-name {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #ffffff;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .info-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 1rem 3rem 3rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .info-label {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #ffffff;
    margin: 0;
  }

  .info-value {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    color: rgba(255,255,255,0.7);
  }

  .info-value-small {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    color: rgba(255,255,255,0.7);
  }

  .about-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 4rem 3rem 7rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 0 3rem;
  }

  .about-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(255,255,255,0.6);
    max-width: 62ch;
    margin: 0;
  }

  .events-btn {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #7A0525;
    background: #ffffff;
    text-decoration: none;
    padding: 0.85rem 2.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .events-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      padding: 0 2rem 4rem;
    }
    .info-col {
      padding: 2rem 1rem;
    }
    .about-section {
      padding: 3rem 2rem 4rem;
      margin: 0 2rem;
    }
  }
</style>
