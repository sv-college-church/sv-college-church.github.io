---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import ismpLogo from '../../assets/images/campuses/logos/ismp.png';

const pageUrl = new URL('/campuses/deanza', Astro.site).href;

const faqs = [
  {
    q: 'Is there mentorship for international students at De Anza College?',
    a: 'Yes. ISMP offers workshops and small group or personal mentorship for international students at De Anza, covering English skills, study habits, and personal development.',
  },
  {
    q: 'Do I have to be religious to join ISMP?',
    a: "No. ISMP's mentorship is based on Christian values, but the content is largely non-religious and open to international students of any background.",
  },
  {
    q: 'How do I sign up for ISMP at De Anza?',
    a: 'Details on workshops and mentorship sign-up are posted on the ISMP website.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Campuses', item: new URL('/campuses', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'De Anza College', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${pageUrl}#ismp`,
    name: 'ISMP at De Anza College',
    alternateName: 'International Student Mentorship Program',
    description: 'A mentorship program for international students at De Anza College, offering workshops and small group or personal mentorship on English skills, study habits, and personal development. Content is largely non-religious and open to all backgrounds.',
    url: pageUrl,
    sameAs: ['https://internationalmentorship.org/deanza'],
    parentOrganization: { '@type': 'Church', name: 'Silicon Valley College Church', url: Astro.site?.href },
    areaServed: { '@type': 'CollegeOrUniversity', name: 'De Anza College' },
    foundingDate: '2025',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="ISMP at De Anza | International Student Mentorship Program"
  description="ISMP offers mentorship for international students at De Anza College: English skills, study habits, and personal development. Open to all backgrounds."
  structuredData={structuredData}
>
  <Nav />

  <main id="main-content">

    <section class="hero-section" style="view-transition-name: campus-deanza">
      <a href="/campuses" class="back-link">← Campuses</a>
      <Image src={ismpLogo} alt="ISMP" class="hero-logo" />
      <p class="hero-fellowship">ISMP</p>
      <h1 class="school-name">De Anza<br/>Community College</h1>
      <p class="hero-tagline">Mentorship for international students at De Anza College</p>
    </section>

    <section class="info-grid">
      <div class="info-col">
        <h2 class="info-label">Established</h2>
        <p class="info-value">2025</p>
      </div>
      <div class="info-col">
        <h2 class="info-label">Events</h2>
        <a href="https://internationalmentorship.org/deanza" target="_blank" rel="noopener noreferrer" class="events-btn">ISMP ↗</a>
      </div>
    </section>

    <section class="about-section">
      <h2 class="info-label">About</h2>
      <p class="about-body">ISMP is a nonprofit mentorship program designed for international students. We offer enriching workshops and small group or personal mentorship sessions that cover practical topics such as English skills, study habits, and personal development areas like relationships, character, and leadership.</p>
      <p class="about-body">Our mentorship is based on Christian values and virtues. However, the content is largely non-religious and open to all international students, regardless of their religious or cultural backgrounds. We welcome everyone, ensuring a safe and supportive environment for all our students.</p>
    </section>

    <section class="faq-section">
      <h2 class="section-heading">Common questions from De Anza students</h2>
      <div class="faq-accordion">
        {faqs.map((f) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false">
              <span>{f.q}</span><span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  html, body { background: #F6F1E4; }
  body { display: flex; flex-direction: column; min-height: 100svh; }
</style>

<style>
  main { flex: 1; display: flex; flex-direction: column; }

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    padding: 12rem 2rem 4rem;
    position: relative;
  }

  .back-link {
    position: absolute;
    top: 9rem;
    left: 2rem;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #896920;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #6E551A; }

  .hero-logo {
    height: 90px;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
    margin-bottom: 0.5rem;
    border-radius: 10px;
  }

  .hero-fellowship {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(35, 32, 29, 0.62);
    margin-bottom: 1.25rem;
  }

  .hero-tagline {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(35, 32, 29, 0.62);
    max-width: 56ch;
    margin-top: 1.5rem;
  }

  .school-name {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 6vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #896920;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 1rem 3rem 2rem;
  }

  .info-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .info-label {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #896920;
    margin: 0;
  }

  .info-value {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    color: rgba(35, 32, 29, 0.75);
  }

  .events-btn {
    display: inline-block;
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #ffffff;
    background: #896920;
    text-decoration: none;
    padding: 0.85rem 2.5rem;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .events-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
  }

  .about-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 4rem 3rem 7rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
    margin: 0 3rem;
  }

  .about-body {
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.62);
    max-width: 62ch;
    margin: 0;
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      padding: 0 2rem 1rem;
    }
    .info-col {
      padding: 2rem 1rem;
    }
    .about-section {
      padding: 3rem 2rem 4rem;
      margin: 0 2rem;
    }
    .faq-section { padding: 3.5rem 1.5rem; }
    .section-heading { margin-bottom: 2rem; }
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 5rem 2rem;
    border-top: 1px solid rgba(35, 32, 29, 0.08);
  }

  .section-heading {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #896920;
    text-align: center;
    margin-bottom: 3rem;
  }

  .faq-accordion {
    max-width: 46rem;
    margin: 0 auto;
    border-top: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-item {
    border-bottom: 1px solid rgba(35, 32, 29, 0.1);
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Instrument Sans', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 800;
    color: #23201D;
    transition: color 0.2s ease;
  }
  .accordion-trigger:hover { color: #896920; }

  .accordion-icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
    color: #896920;
    transition: transform 0.25s ease;
  }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-content p {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(35, 32, 29, 0.6);
    padding-bottom: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.parentElement!;
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      content.style.maxHeight = !isOpen ? content.scrollHeight + 'px' : '';
    });
  });
</script>
